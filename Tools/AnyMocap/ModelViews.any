Views = {
    AnyFolder SetViewMacros = {
      AnyOperationSequence KinematicView= {        
        AnyOperationClassOpr SetKinematicView = {
              OPERATION_DISPLAY_PRIORITY(PriorityLow);
              Object = &...KinematicView;
              OperationName = "Set View";
        };
      };
      AnyOperationSequence InverseDynamicView = {       
        AnyOperationClassOpr SetInverseDynamicView = {
              OPERATION_DISPLAY_PRIORITY(PriorityLow);
              Object = &...InverseDynamicView;
              OperationName = "Set View";
       };
     };
    };
    AnyFolder DrawGroups = {
      AnyDrawGroup All_Markers ={
        Objects = ObjSearchRecursive("Main.ModelSetup.MocapDrivers","*", "AnyDrawObject");
      };
      AnyDrawGroup All_MarkerArrows = {
        Objects = ObjSearchRecursive("Main.HumanModel.BodyModel","Arrow*", "AnyDrawVector");
      };
      AnyDrawGroup All_Human ={
        Objects = set_difference( ObjSearchRecursive("Main.HumanModel","*", "AnyDrawObject"), .All_Muscles.Objects, .All_MarkerArrows.Objects, .ForceRelatedObjects.Objects);
      };
      AnyDrawGroup All_Environment ={
        Objects = ObjSearchRecursive("Main.EnvironmentModel","*", "AnyDrawObject");
      };
      AnyDrawGroup All ={
        Objects = ObjSearchRecursive("Main","*", "AnyDrawObject");
      };
      AnyDrawGroup All_Muscles =
      {
        Objects = arrcat(
          ObjSearchRecursive("Main.HumanModel.BodyModel","*", "AnyDrawMuscle"),
          ObjSearchRecursive("Main.HumanModel.BodyModel.Trunk.Buckle", "*", "AnyDrawParamSurf"),
          ObjSearchRecursive("Main.HumanModel.BodyModel.Trunk.Abdominal.Volumes","*", "AnyDrawKinMeasure"),
        );
      };

      AnyDrawGroup All_StickFigure =
      {
        Objects = arrcat( ObjSearchRecursive("Main.ModelSetup.BVHFileData.Model","*", "AnyDrawSeg"),
                          ObjSearchRecursive("Main.ModelSetup.BVHFileData.Model","*", "AnyDrawNode"),
                          ObjSearchRecursive("Main.ModelSetup.BVHFileData.Model","*", "AnyDrawRefFrame"));
      };

      AnyDrawGroup All_Unfiltered_Markers =
      {
        Objects = arrcat(ObjSearchRecursive("Main.ModelSetup.MocapDrivers","*.Test_Visual.UnfilteredTest", "AnyDrawSphere"));
      };

      AnyDrawGroup All_Marker_Drivers =
      {
        Objects = arrcat(ObjSearchRecursive("Main.ModelSetup.MocapDrivers","*.Driver.Draw", "AnyDrawKinMeasure"));
      };

      AnyDrawGroup GRF_Trigger_volume =
      {
        Objects = arrcat(
             ObjSearch("Main.EnvironmentModel.ForcePlates.*.DrawUpperTriggerVolume", "AnyDrawLine"),
             ObjSearch("Main.EnvironmentModel.ForcePlates.*.DrawLowerTriggerVolume", "AnyDrawLine")
             );
      };

      AnyDrawGroup ForceRelatedObjects= {
        Objects = arrcat(
            ObjSearchRecursive("Main.EnvironmentModel.ForcePlates", "CenterOfPressure.Line", "AnyDrawObject"),
            ObjSearchRecursive("Main.EnvironmentModel.ForcePlates", "ForcePlate.COP_ball", "AnyDrawObject"),
            ObjSearchRecursive("Main.EnvironmentModel.ForcePlates", "ForcePlate.PlateSurface.COP_ball", "AnyDrawObject"),
            ObjSearchRecursive("Main.EnvironmentModel.ForcePlates", "ForcePlate.PlateSurface.COP_ball", "AnyDrawObject"),
            ObjSearchRecursive("Main.HumanModel.BodyModel.Left.Leg.Segments.Foot.ConditionalContact_Nodes", "Dr*", "AnyDrawObject"),
            ObjSearchRecursive("Main.HumanModel.BodyModel.Right.Leg.Segments.Foot.ConditionalContact_Nodes", "Dr*", "AnyDrawObject"),
            .GRF_Trigger_volume.Objects
        );
      };
    };//DrawGroups
    AnyStandardModelViewDefinition AllView = {
      ViewName = "View all";
      DrawGroupSequence = {&.DrawGroups.All};
      Hide = DesignVar({Off});
      Reset = {On};
      ShowModelDefined = {Off};
      HideAllFirst = On;
      AnyOperationSequence HideView = {OPERATION_DISPLAY_PRIORITY(PriorityLow); AnyOperationClassOpr AllViewHideOn = {Object = &...AllView.Hide; OperationName = "Set Value"; ArgList = {AnySwitchVar value = On;};}; AnyOperationClassOpr AllViewSetView = {Object = &...AllView; OperationName = "Set View";}; AnyOperationClassOpr AllViewHideResetValue = {Object = &...AllView.Hide; OperationName = "Reset Value";};};
      AnyOperationSequence ShowView = {OPERATION_DISPLAY_PRIORITY(PriorityLow); AnyOperationClassOpr AllViewHideOff = {Object = &...AllView.Hide; OperationName = "Set Value"; ArgList = {AnySwitchVar value = Off;};}; AnyOperationClassOpr AllViewSetView = {Object = &...AllView; OperationName = "Set View";}; AnyOperationClassOpr AllViewHideResetValue = {Object = &...AllView.Hide; OperationName = "Reset Value";};};
    };
    AnyStandardModelViewDefinition MarkerArrowsView ={
      ViewName = "AnyMoCap View Marker Arrows";
      DrawGroupSequence = {&.DrawGroups.All_MarkerArrows};
      Hide = DesignVar({Off});
      Reset = {On};
      HideAllFirst = Off;
      AnyOperationSequence HideView = {OPERATION_DISPLAY_PRIORITY(PriorityLow); AnyOperationClassOpr MarkerArrowsViewHideOn = {Object = &...MarkerArrowsView.Hide; OperationName = "Set Value"; ArgList = {AnySwitchVar value = On;};}; AnyOperationClassOpr MarkerArrowsViewSetView = {Object = &...MarkerArrowsView; OperationName = "Set View";}; AnyOperationClassOpr MarkerArrowsViewHideResetValue = {Object = &...MarkerArrowsView.Hide; OperationName = "Reset Value";};};
      AnyOperationSequence ShowView = {OPERATION_DISPLAY_PRIORITY(PriorityLow); AnyOperationClassOpr MarkerArrowsViewHideOff = {Object = &...MarkerArrowsView.Hide; OperationName = "Set Value"; ArgList = {AnySwitchVar value = Off;};}; AnyOperationClassOpr MarkerArrowsViewSetView = {Object = &...MarkerArrowsView; OperationName = "Set View";}; AnyOperationClassOpr MarkerArrowsViewHideResetValue = {Object = &...MarkerArrowsView.Hide; OperationName = "Reset Value";};};
    };
    AnyStandardModelViewDefinition MarkerView ={
      ViewName = "AnyMoCap View Markers";
      DrawGroupSequence = {&.DrawGroups.All_Markers};
      Hide = DesignVar({Off});
      Reset = {On};
      HideAllFirst = Off;
      AnyOperationSequence HideView = {OPERATION_DISPLAY_PRIORITY(PriorityLow); AnyOperationClassOpr MarkerViewHideOn = {Object = &...MarkerView.Hide; OperationName = "Set Value"; ArgList = {AnySwitchVar value = On;};}; AnyOperationClassOpr MarkerViewSetView = {Object = &...MarkerView; OperationName = "Set View";}; AnyOperationClassOpr MarkerViewHideResetValue = {Object = &...MarkerView.Hide; OperationName = "Reset Value";};};
      AnyOperationSequence ShowView = {OPERATION_DISPLAY_PRIORITY(PriorityLow); AnyOperationClassOpr MarkerViewHideOff = {Object = &...MarkerView.Hide; OperationName = "Set Value"; ArgList = {AnySwitchVar value = Off;};}; AnyOperationClassOpr MarkerViewSetView = {Object = &...MarkerView; OperationName = "Set View";}; AnyOperationClassOpr MarkerViewHideResetValue = {Object = &...MarkerView.Hide; OperationName = "Reset Value";};};
    };
    AnyStandardModelViewDefinition HumanView ={
      ViewName = "AnyMoCap View Human";
      DrawGroupSequence = {&.DrawGroups.All_Human};
      Hide = DesignVar({Off});
      Reset = {On};
      HideAllFirst = Off;      
      AnyOperationSequence HideView = {OPERATION_DISPLAY_PRIORITY(PriorityLow); AnyOperationClassOpr HumanViewHideOn = {Object = &...HumanView.Hide; OperationName = "Set Value"; ArgList = {AnySwitchVar value = On;};}; AnyOperationClassOpr HumanViewSetView = {Object = &...HumanView; OperationName = "Set View";}; AnyOperationClassOpr HumanViewHideResetValue = {Object = &...HumanView.Hide; OperationName = "Reset Value";};};
      AnyOperationSequence ShowView = {OPERATION_DISPLAY_PRIORITY(PriorityLow); AnyOperationClassOpr HumanViewHideOff = {Object = &...HumanView.Hide; OperationName = "Set Value"; ArgList = {AnySwitchVar value = Off;};}; AnyOperationClassOpr HumanViewSetView = {Object = &...HumanView; OperationName = "Set View";}; AnyOperationClassOpr HumanViewHideResetValue = {Object = &...HumanView.Hide; OperationName = "Reset Value";};};
    };
    AnyStandardModelViewDefinition Muscles ={
      ViewName = "AnyMoCap View Muscles";
      DrawGroupSequence = {&.DrawGroups.All_Muscles};
      Hide = DesignVar({Off});
      Reset = {On};
      HideAllFirst = Off;      
      AnyOperationSequence HideView = {OPERATION_DISPLAY_PRIORITY(PriorityLow); AnyOperationClassOpr MusclesHideOn = {Object = &...Muscles.Hide; OperationName = "Set Value"; ArgList = {AnySwitchVar value = On;};}; AnyOperationClassOpr MusclesSetView = {Object = &...Muscles; OperationName = "Set View";}; AnyOperationClassOpr MusclesHideResetValue = {Object = &...Muscles.Hide; OperationName = "Reset Value";};};
      AnyOperationSequence ShowView = {OPERATION_DISPLAY_PRIORITY(PriorityLow); AnyOperationClassOpr MusclesHideOff = {Object = &...Muscles.Hide; OperationName = "Set Value"; ArgList = {AnySwitchVar value = Off;};}; AnyOperationClassOpr MusclesSetView = {Object = &...Muscles; OperationName = "Set View";}; AnyOperationClassOpr MusclesHideResetValue = {Object = &...Muscles.Hide; OperationName = "Reset Value";};};
    };
 #if MOCAP_INPUT_DATA_TYPE == "BVH"
    AnyStandardModelViewDefinition BVHStickFigure ={
      ViewName = "AnyMoCap View BVH Stickfigure";
      DrawGroupSequence = {&.DrawGroups.All_StickFigure};
      Hide = DesignVar({Off});
      Reset = {On};
      HideAllFirst = Off;      
      AnyOperationSequence HideView = {OPERATION_DISPLAY_PRIORITY(PriorityLow); AnyOperationClassOpr BVHStickFigureHideOn = {Object = &...BVHStickFigure.Hide; OperationName = "Set Value"; ArgList = {AnySwitchVar value = On;};}; AnyOperationClassOpr BVHStickFigureSetView = {Object = &...BVHStickFigure; OperationName = "Set View";}; AnyOperationClassOpr BVHStickFigureHideResetValue = {Object = &...BVHStickFigure.Hide; OperationName = "Reset Value";};};
      AnyOperationSequence ShowView = {OPERATION_DISPLAY_PRIORITY(PriorityLow); AnyOperationClassOpr BVHStickFigureHideOff = {Object = &...BVHStickFigure.Hide; OperationName = "Set Value"; ArgList = {AnySwitchVar value = Off;};}; AnyOperationClassOpr BVHStickFigureSetView = {Object = &...BVHStickFigure; OperationName = "Set View";}; AnyOperationClassOpr BVHStickFigureHideResetValue = {Object = &...BVHStickFigure.Hide; OperationName = "Reset Value";};};
    };
#endif
    AnyStandardModelViewDefinition ForcePlates ={
      ViewName = "AnyMoCap View ForcePlate";
      DrawGroupSequence = {&.DrawGroups.ForceRelatedObjects};
      Hide = DesignVar({Off});
      Reset = {On};
      HideAllFirst = Off;      
      AnyOperationSequence HideView = {OPERATION_DISPLAY_PRIORITY(PriorityLow); AnyOperationClassOpr ForcePlatesHideOn = {Object = &...ForcePlates.Hide; OperationName = "Set Value"; ArgList = {AnySwitchVar value = On;};}; AnyOperationClassOpr ForcePlatesSetView = {Object = &...ForcePlates; OperationName = "Set View";}; AnyOperationClassOpr ForcePlatesHideResetValue = {Object = &...ForcePlates.Hide; OperationName = "Reset Value";};};
      AnyOperationSequence ShowView = {OPERATION_DISPLAY_PRIORITY(PriorityLow); AnyOperationClassOpr ForcePlatesHideOff = {Object = &...ForcePlates.Hide; OperationName = "Set Value"; ArgList = {AnySwitchVar value = Off;};}; AnyOperationClassOpr ForcePlatesSetView = {Object = &...ForcePlates; OperationName = "Set View";}; AnyOperationClassOpr ForcePlatesHideResetValue = {Object = &...ForcePlates.Hide; OperationName = "Reset Value";};};  
    };

    AnyStandardModelViewDefinition KinematicView ={
      ViewName = "AnyMoCap Kinematic View";
      DrawGroupSequence = {&.DrawGroups.All, &.DrawGroups.All_Muscles, &.DrawGroups.ForceRelatedObjects, &.DrawGroups.All_StickFigure};
      Reset = {On,Off, On,Off};
      Hide = {Off, On, On,On};
      ShowModelDefined = {Off,Off, Off, Off};
      ShowAutoGenerated = {Off,Off, Off, Off};
      AnyOperationSequence ShowView = {OPERATION_DISPLAY_PRIORITY(PriorityLow); AnyOperationClassOpr KinematicViewSetView = {Object = &...KinematicView; OperationName = "Set View";};};  
    };
    AnyStandardModelViewDefinition InverseDynamicView = {
      ViewName = "AnyMoCap InverseDynamic View";
      DrawGroupSequence = {&.DrawGroups.All, &.DrawGroups.All_MarkerArrows, &.DrawGroups.All_StickFigure, &.DrawGroups.All_Unfiltered_Markers, &.DrawGroups.All_Marker_Drivers};
      Reset = {On,Off,Off,Off,Off};
      Hide = {Off, On,On, On, Off};
      ShowModelDefined = {Off,Off,Off,Off,Off};
      ShowAutoGenerated = {Off,Off,Off,Off,Off};
      AnyOperationSequence ShowView = {OPERATION_DISPLAY_PRIORITY(PriorityLow); AnyOperationClassOpr InverseDynamicViewSetView = {Object = &...InverseDynamicView; OperationName = "Set View";};};  
    };

};