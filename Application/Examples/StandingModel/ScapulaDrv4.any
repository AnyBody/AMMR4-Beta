Main.Study = {
  AnyMechObjectExcluder ExcludeConoidDriver = {
    Objects = {
               &Main.HumanModel.BodyModel.Right.ShoulderArm.Jnt.ScapulaAIThoraxNodeDriver,
               &Main.HumanModel.BodyModel.Right.ShoulderArm.Jnt.ScapulaComboMeasure.LateralConstraint.LimitDrv.JointLimitDriver,
               &Main.HumanModel.BodyModel.Right.ShoulderArm.Jnt.ScapulaComboMeasure.FrontalConstraint.LimitDrv.JointLimitDriver,
               &Main.HumanModel.BodyModel.Right.ShoulderArm.Jnt.ScapulaComboMeasure.DistalConstraint.LimitDrv.JointLimitDriver,
               &Main.HumanModel.BodyModel.Right.ShoulderArm.Jnt.ScapulaComboMeasure.MedialConstraint.LimitDrv.JointLimitDriver,
///////////////////////////
               &Main.HumanModel.BodyModel.Left.ShoulderArm.Jnt.ScapulaAIThoraxNodeDriver,
               &Main.HumanModel.BodyModel.Left.ShoulderArm.Jnt.ScapulaComboMeasure.LateralConstraint.LimitDrv.JointLimitDriver,
               &Main.HumanModel.BodyModel.Left.ShoulderArm.Jnt.ScapulaComboMeasure.FrontalConstraint.LimitDrv.JointLimitDriver,
               &Main.HumanModel.BodyModel.Left.ShoulderArm.Jnt.ScapulaComboMeasure.DistalConstraint.LimitDrv.JointLimitDriver,
               &Main.HumanModel.BodyModel.Left.ShoulderArm.Jnt.ScapulaComboMeasure.MedialConstraint.LimitDrv.JointLimitDriver,
              };
  };
};
