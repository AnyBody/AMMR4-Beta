Main.HumanModel.BodyModel.Right.ShoulderArm.Seg.Scapula = {

  AnyRefNode NodeForClavicula = {
    sRel = .conoid.sRel + .Scale({0.015,0.015,-0.015});
  };
  AnyRefNode NodeForThorax = {
    sRel = .ScapulaSlidingTS.sRel;
  };
  AnyRefNode NormalNode = {
    sRel = .acj.sRel;
    ARel = RotMat(sRel,.ScapulaSlidingTS.sRel , .ScapulaSlidingAI.sRel );
    AnyDrawRefFrame drw1 ={RGB={1,0,0};ScaleXYZ={1,1,1}*0.1;};
  };
};

Main.HumanModel.BodyModel.Trunk.Segments.ThoraxSeg.T4 = {
  AnyRefNode NodeForScapulaR = {
    sRel = .T3T4JntNode.sRel + .Scale({-0.05,0.00,0.07});
  };
};

Main.HumanModel.BodyModel.Right.ShoulderArm.Jnt = {
  AnyFolder ScapulaAverageMeasure = {
    AnyFolder SpringMeasures = {
      AnyKinLinear M1 = {
        Ref=0;
        AnyRefFrame &ref1= Main.HumanModel.BodyModel.Right.ShoulderArm.Seg.Scapula.NodeForClavicula;
        AnyRefFrame &ref2= Main.HumanModel.BodyModel.Right.ShoulderArm.Seg.Clavicula.conoid;
        AnyDrawPLine drw ={Thickness=0.0025;};   
        ref1= {AnyDrawRefFrame drw1 ={RGB={1,0,0};ScaleXYZ={1,1,1}*0.1;};};      
        ref2= {AnyDrawRefFrame drw2 ={RGB={0,0,1};ScaleXYZ={1,1,1}*0.1;};};     
      };
      AnyKinLinear M2 = {
        Ref=0;
        AnyRefFrame &ref1= Main.HumanModel.BodyModel.Right.ShoulderArm.Seg.Scapula.NodeForThorax;
        AnyRefFrame &ref2= Main.HumanModel.BodyModel.Trunk.Segments.ThoraxSeg.T4.NodeForScapulaR;
        AnyDrawPLine drw ={Thickness=0.0025;};   
        ref1= {AnyDrawRefFrame drw1 ={RGB={1,0,0};ScaleXYZ={1,1,1}*0.1;};};      
        ref2= {AnyDrawRefFrame drw2 ={RGB={0,0,1};ScaleXYZ={1,1,1}*0.1;};};     
      };
    }; // Spring Measures
    AnyKinEq RotationConstraint = {
      RigidBodyAverageMeasure CombinationMeasure(ROTATIONAL=On, LINEAR=Off,POWER =3) = { 
        LocalReferenceFrame = &Main.HumanModel.BodyModel.Right.ShoulderArm.Seg.Scapula.NormalNode;
        InputMeasures = {
          &..SpringMeasures.M1,
          &..SpringMeasures.M2,
          
        };
        
        WeightCoefficients = {1,0.1};
      };
      Reaction.Type ??= repmat(1, Off);      
      MeasureOrganizer = {2};      
    };   // RotationConstraint 
    
  }; // ScapulaAverageMeasure
  
};


