#include "RigidBodyAverageMeasure.ClassTemplate.any"

Main ={
  
  AnyBodyStudy Study ={
    
    Gravity ={0,0,0};
    
    AnyFixedRefFrame Frm ={ 
      
      AnyRefNode Node2 ={
        sRel ={1,0,0};
      };
      
      AnyRefNode Node3 ={
        sRel ={1,2,0};
      };
      
    };
    
    AnySeg Segment ={
      Mass=10;
      Jii={0.1,0.1,0.1};
      AnyDrawSeg drw ={};
      AnyRefNode Node1 ={
        sRel ={-0.5,0,0};
        
        AnyDrawRefFrame drw1 ={RGB={1,0,0};ScaleXYZ={1,1,1}*0.1;};
        
      };
      AnyRefNode Node2 ={
        sRel ={0.5,0,0};
        AnyDrawRefFrame drw1 ={RGB={1,0,0};ScaleXYZ={1,1,1}*0.1;};
        
      };
      
      AnyRefNode Node3 ={
        sRel ={1,0.05,0};
        AnyDrawRefFrame drw1 ={RGB={1,0,0};ScaleXYZ={1,1,1}*0.1;};
      };
    };
    
    
    
    AnyRevoluteJoint Jnt ={
      AnyRefFrame &ref1=.Frm;
      AnyRefFrame &ref2=.Segment.Node1;
    };
    
    AnyFolder SpringMeasures ={
      AnyKinLinear M1 ={ 
        Ref=0;
        AnyRefFrame &ref1=..Frm.Node2;
        AnyRefFrame &ref2=..Segment.Node2;
        AnyDrawPLine drw ={Thickness=0.0025;};   
        ref1= {AnyDrawRefFrame drw1 ={RGB={1,0,0};ScaleXYZ={1,1,1}*0.1;};};      
        ref2= {AnyDrawRefFrame drw2 ={RGB={0,0,1};ScaleXYZ={1,1,1}*0.1;};};      
        
      };
      AnyKinLinear M2 ={ 
        Ref=0;
        AnyRefFrame &ref1=..Frm.Node3;
        AnyRefFrame &ref2=..Segment.Node3;
        AnyDrawPLine drw ={Thickness=0.0025;};   
        ref1= {AnyDrawRefFrame drw1 ={RGB={1,0,0};ScaleXYZ={1,1,1}*0.1;};};      
        ref2= {AnyDrawRefFrame drw2 ={RGB={0,0,1};ScaleXYZ={1,1,1}*0.1;};};      
        
      };
      
      
      
    };
    
    
    AnyKinEq RotationConstraint = {
      RigidBodyAverageMeasure CombinationMeasure(ROTATIONAL=On, LINEAR=Off,POWER =3) = { 
        LocalReferenceFrame = &..Segment.Node1;
        InputMeasures = {
          &..SpringMeasures.M1,
          &..SpringMeasures.M2,
          
        };
        
        WeightCoefficients = {1,0.1};
      };
      Reaction.Type ??= repmat(1, Off);
      
      
      MeasureOrganizer = {2};
      
      
    };
    
    
    
  };
  
  
  
  
  
};




