Main.Study = {
  AnyMechObjectExcluder ExcludeConoidDriver = {
    Objects = {
               &Main.HumanModel.BodyModel.Right.ShoulderArm.Jnt.ConoideumLigamentDrv,
               &Main.HumanModel.BodyModel.Left.ShoulderArm.Jnt.ConoideumLigamentDrv,
               &Main.HumanModel.BodyModel.Right.ShoulderArm.Jnt.ScapulaComboMeasure.PLineMeasures.LimitM2.JointLimitDriver,
               &Main.HumanModel.BodyModel.Right.ShoulderArm.Jnt.ScapulaComboMeasure.PLineMeasures.LimitM3.JointLimitDriver,
