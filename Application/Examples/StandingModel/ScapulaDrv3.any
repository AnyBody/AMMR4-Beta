#include "<ANYBODY_PATH_MODELUTILS>/KinematicLimits/RangeOfMotionLimits_template.any"
Main.Model.Environment.GlobalRef = {
  AnyRefNode ScapulaNode = {
    sRel = srel;
    AnyFloat srel = Main.HumanModel.BodyModel.Right.ShoulderArm.Seg.Scapula.r0 + 
            Main.HumanModel.BodyModel.Right.ShoulderArm.Seg.Scapula.ai.sRel*Main.HumanModel.BodyModel.Right.ShoulderArm.Seg.Scapula.Axes0';
    AnyDrawRefFrame drw1 ={RGB={0,1,0};ScaleXYZ={1,1,1}*0.1;};
  };
  AnyRefNode ThoraxNode = {
    sRel = srel;
    AnyFloat srel = Main.HumanModel.BodyModel.Trunk.Segments.T7Seg.r0+ 
            Main.HumanModel.BodyModel.Trunk.Segments.T7Seg.Right.O_trapezius_scapular_part_6.sRel*Main.HumanModel.BodyModel.Trunk.Segments.T7Seg.Axes0';
    AnyDrawRefFrame drw1 ={RGB={0,1,0};ScaleXYZ={1,1,1}*0.1;};
    AnySurfSphere SphereDwg = {
      viewSurface.Visible = On;
      viewSurface.Opacity = 0.5;
      viewSurface.RGB = {1,1,0};
      Radius = vnorm(.srel-..ScapulaNode.srel);
    };
  };
};

Main.HumanModel.BodyModel.Right.ShoulderArm.Seg.Scapula.ai = {
  AnyDrawRefFrame drw1 ={RGB={0,1,0};ScaleXYZ={1,1,1}*0.1;};
};
Main.HumanModel.BodyModel.Trunk.Segments.T7Seg.Right.O_trapezius_scapular_part_6 = {
  AnyDrawRefFrame drw1 ={RGB={0,1,0};ScaleXYZ={1,1,1}*0.1;};
  AnySurfSphere SphereDwg = {
    viewSurface.Visible = On;
    viewSurface.Opacity = 0.5;
    viewSurface.RGB = {1,1,0};
    Radius = vnorm(Main.Model.Environment.GlobalRef.ThoraxNode.srel-Main.Model.Environment.GlobalRef.ScapulaNode.srel);
  };
  AnySurfSphere Sphere2Dwg = {
    viewSurface.Visible = On;
    viewSurface.Opacity = 0.2;
    viewSurface.RGB = {0,1,1};
    Radius = 1.5*vnorm(Main.Model.Environment.GlobalRef.ThoraxNode.srel-Main.Model.Environment.GlobalRef.ScapulaNode.srel);
  };
  AnySurfSphere Sphere3Dwg = {
    viewSurface.Visible = On;
    viewSurface.Opacity = 0.2;
    viewSurface.RGB = {0,0,1};
    Radius = 0.5*vnorm(Main.Model.Environment.GlobalRef.ThoraxNode.srel-Main.Model.Environment.GlobalRef.ScapulaNode.srel);
  };
};  
Main.HumanModel.BodyModel.Right.ShoulderArm.Jnt = {
  AnyFolder ScapulaComboMeasure = {
    AnyFolder PLineMeasures = {
//      AnyFloat M3LengthInNeutral = 
      AnyKinPLine M1 = {
        AnyRefFrame &ref1= Main.HumanModel.BodyModel.Right.ShoulderArm.Seg.Scapula.conoid;
        AnyRefFrame &ref2= Main.HumanModel.BodyModel.Right.ShoulderArm.Seg.Clavicula.conoid;
        AnyDrawPLine drw ={Thickness=0.0025;};   
        ref1= {AnyDrawRefFrame drw1 ={RGB={1,0,0};ScaleXYZ={1,1,1}*0.1;};};      
        ref2= {AnyDrawRefFrame drw2 ={RGB={0,0,1};ScaleXYZ={1,1,1}*0.1;};};     
      };
      AnyKinPLine M2 = {
        AnyRefFrame &ref1= Main.HumanModel.BodyModel.Right.ShoulderArm.Seg.Scapula.I_rhomboideus_1;
        AnyRefFrame &ref2= Main.HumanModel.BodyModel.Trunk.Segments.C7Seg.Right.O_rhomboideus_1;
        AnyDrawPLine drw ={Thickness=0.0025;};   
        ref1= {AnyDrawRefFrame drw1 ={RGB={1,0,0};ScaleXYZ={1,1,1}*0.1;};};      
        ref2= {AnyDrawRefFrame drw2 ={RGB={0,0,1};ScaleXYZ={1,1,1}*0.1;};};     
      };
      AnyKinPLine M3 = {
        AnyRefFrame &ref1= Main.HumanModel.BodyModel.Right.ShoulderArm.Seg.Scapula.I_rhomboideus_6;
        AnyRefFrame &ref2= Main.HumanModel.BodyModel.Trunk.Segments.ThoraxSeg.T5.Right.O_rhomboideus_6;
        AnyDrawPLine drw ={Thickness=0.0025;};   
        ref1= {AnyDrawRefFrame drw1 ={RGB={1,0,0};ScaleXYZ={1,1,1}*0.1;};};      
        ref2= {AnyDrawRefFrame drw2 ={RGB={0,0,1};ScaleXYZ={1,1,1}*0.1;};};     
      };
      KinLimitsDriver LimitM2( 
        KinMeasure = .M2
        ) = {
          AnyFloat ROM ??= 0.1103 + {-0.05, 0.05};
          LowerLimit = ROM[0]; 
          HighLimit = ROM[1]; 
        };
      KinLimitsDriver LimitM3( 
        KinMeasure = .M3
        ) = {
          AnyFloat ROM ??= 0.0858 + {-0.05, 0.05};
          LowerLimit = ROM[0]; 
          HighLimit = ROM[1]; 
        };
      AnyKinMeasureLinComb LinCombM1M2M3 = {
        AnyKinMeasure &meas1 = .M1;
        AnyKinMeasure &meas2 = .LimitM2.JointLimitMeasure;
        AnyKinMeasure &meas3 = .LimitM3.JointLimitMeasure;
        OutDim = 1;
        Coef = {{1,1,1}};
        Const = {0};
      };
    }; // PLineMeasures
    AnyKinEqSimpleDriver DrvCombMeasure = {
      AnyKinMeasure &CombMeas = .PLineMeasures.LinCombM1M2M3;
      DriverPos = {Main.HumanModel.BodyModel.Right.ShoulderArm.Jnt.ConoideumLigamentDrv.ScaleStdConoidVectorLength};
      DriverVel = {0.0};
    };    
  }; // ScapulaComboMeasure
  
};


