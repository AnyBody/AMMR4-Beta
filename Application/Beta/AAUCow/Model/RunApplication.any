 // Switch to define an automatic save of results to the Output folder
#ifndef AutoSaveOption
#define AutoSaveOption 0
#endif

AnyOperationSequence RunApplication = {

  ///This operation is the inverse dynamic analysis
  AnyOperation &InvAnal=Main.Study.InverseDynamics;


  #if AutoSaveOption
  /// This operation saves the output of the study to an h5 file in the Output folder
  AnyOperationClassOpr save = {
        Object = &Main.Study.Output;
        OperationName = "Save data";
        ArgList = {
          AnyStringVar file = ANYBODY_PATH_OUTPUT + ANYBODY_NAME_MAINFILE + ".anydata.h5";
          AnyStringVar type = "Deep";
        };
  };
  #endif
};

