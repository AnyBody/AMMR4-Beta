// Definitions of muscles in the right leg
// Mark de Zee

// This is an interface reference to make sure that the
// include file MusDrawSettings.any always can be left
// unchanged and not affected of different directory
// levels.

AnyFolder &Ref = ..MusDrawRef;

AnyMuscleViaPoint Ham = {
  AnyMuscleModel &MusMdl = ..MusPar.HamMdl;
  AnyRefNode &Ins = ..Segments.Shank.HamNodeR;
  AnyRefNode &Via1 = ..Segments.Thigh.HamsViaNode1R;
  AnyRefNode &Org = ..HipNodeRef.HamNodeR;
  viewMuscle = {#include "../DrawSettings/MusDrawSettings.any"};
};

AnyMuscleViaPoint BiFemSh = {
  AnyMuscleModel &MusMdl = ..MusPar.BiFemShMdl;
  AnyRefNode &Ins = ..Segments.Shank.BiFemShNodeR;
  AnyRefNode &Org = ..Segments.Thigh.BiFemShNodeR;
  viewMuscle = {#include "../DrawSettings/MusDrawSettings.any"};
};

AnyMuscleViaPoint GlutMax = {
  AnyMuscleModel &MusMdl = ..MusPar.GlutMaxMdl;
  AnyRefNode &Ins = ..Segments.Thigh.GlutMaxNodeR;
  AnyRefNode &Via3 = ..Segments.Thigh.GlutMaxViaNode2R;
  AnyRefNode &Via2 = ..HipNodeRef.GlutMaxViaNode2R;
  AnyRefNode &Via1 = ..HipNodeRef.GlutMaxViaNode1R;
  AnyRefNode &Org = ..HipNodeRef.GlutMaxNodeR;
  viewMuscle = {#include "../DrawSettings/MusDrawSettings.any"};
};

AnyMuscleViaPoint RectFem = {
  AnyMuscleModel &MusMdl = ..MusPar.RectFemMdl;
  AnyRefNode &Ins = ..Segments.Shank.Rect_FemNodeR;
  AnyRefNode &Via2 = ..Segments.Thigh.Rect_FemViaNode2R;
  AnyRefNode &Org = ..HipNodeRef.Rect_FemNodeR;
  viewMuscle = {#include "../DrawSettings/MusDrawSettings.any"};
};

AnyMuscleViaPoint Vasti = {
  AnyMuscleModel &MusMdl = ..MusPar.VastiMdl;
  AnyRefNode &Ins = ..Segments.Shank.VastiNodeR;
  AnyRefNode &Via2 = ..Segments.Thigh.VastiViaNode2R; //In SIMM one can define in which range this ViaPoint is working, which is not possible in AnyBody
  AnyRefNode &Via1 = ..Segments.Thigh.VastiViaNode1R;
  AnyRefNode &Org = ..Segments.Thigh.VastiNodeR;
  viewMuscle = {#include "../DrawSettings/MusDrawSettings.any"};
};

AnyMuscleViaPoint Gas = {
  AnyMuscleModel &MusMdl = ..MusPar.GasMdl;
  AnyRefNode &Ins = ..Segments.Foot.GasNodeR;
  AnyRefNode &Via2 = ..Segments.Shank.GasViaNode2R;
  //AnyRefNode &Via1 = ..Segments.Thigh.GasViaNode1R; //In SIMM one can define in which range this ViaPoint is working, which is not possible in AnyBody
  AnyRefNode &Org = ..Segments.Thigh.GasNodeR;
  viewMuscle = {#include "../DrawSettings/MusDrawSettings.any"};
};

AnyMuscleViaPoint Sol = {
  AnyMuscleModel &MusMdl = ..MusPar.SolMdl;
  AnyRefNode &Ins = ..Segments.Foot.SolNodeR;
  AnyRefNode &Org = ..Segments.Shank.SolNodeR;
  viewMuscle = {#include "../DrawSettings/MusDrawSettings.any"};
};

AnyMuscleViaPoint TibAnt = {
  AnyMuscleModel &MusMdl = ..MusPar.TibAntMdl;
  AnyRefNode &Ins = ..Segments.Foot.Tib_AntNodeR;
  AnyRefNode &Via1 = ..Segments.Shank.Tib_AntViaNode1R;
  AnyRefNode &Org = ..Segments.Shank.Tib_AntNodeR;
  viewMuscle = {#include "../DrawSettings/MusDrawSettings.any"};
};



