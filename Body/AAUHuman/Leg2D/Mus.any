AnyMuscleViaPoint Gastrocnemius = {
  AnyMuscleModel &MusMdl = ..MusPar.GastrocnemiusMdl;
  AnyRefNode &Ins = ..Seg.Foot.GastrocnemiusNodeR;
  AnyRefNode &Via2 = ..Seg.Shank.GastrocnemiusViaNode2R;
  //AnyRefNode &Via1 = ..Seg.Thigh.GastrocnemiusViaNode1R; //In SIMM one can define in which range this ViaPoint is working, which is not possible in AnyBody
  AnyRefNode &Org = ..Seg.Thigh.GastrocnemiusNodeR;
  viewMuscle = {#include "../DrawSettings/MusDrawSettings.any"};
};

