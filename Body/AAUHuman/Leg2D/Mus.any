// Definitions of muscles in the right leg
// Mark de Zee

// This is an interface reference to make sure that the
// include file MusDrawSettings.any always can be left
// unchanged and not affected of different directory
// levels.

AnyFolder &Ref = ..MusDrawRef;

AnyMuscleViaPoint Hammstrings = {
  AnyMuscleModel &MusMdl = ..MusPar.HamstringsMdl;
  AnyRefNode &Ins = ..Seg.Shank.HamstringsNodeR;
  AnyRefNode &Via1 = ..Seg.Thigh.HamstringsViaNode1R;
  AnyRefNode &Org = ..HipNodeRef.HamstringsNodeR;
  viewMuscle = {#include "../DrawSettings/MusDrawSettings.any"};
};

AnyMuscleViaPoint BicepsFemorisCaputBreve = {
  AnyMuscleModel &MusMdl = ..MusPar.BicepsFemorisCaputBreveMdl;
  AnyRefNode &Ins = ..Seg.Shank.BicepsFemorisCaputBreveNodeR;
  AnyRefNode &Org = ..Seg.Thigh.BicepsFemorisCaputBreveNodeR;
  viewMuscle = {#include "../DrawSettings/MusDrawSettings.any"};
};

