      /// Internal positive
      AnyVar ElbowHumeroUlnar_AxialMoment = ....Right.ShoulderArm.MomentMeasure.ElbowJointReactionMoments.Mlocal[1];
      /// Medial positive
      AnyVar ElbowHumeroUlnar_LateralMoment = ....Right.ShoulderArm.MomentMeasure.ElbowJointReactionMoments.Mlocal[2];
      // humerus fe ref

      /// Ulnar positive
      AnyVar ProximalRadioUlnar_RadialForce = ....Right.ShoulderArm.Joints.ProximalRadioUlnarJoint.ReacForce.Fout[0];
      /// Dorsal positive
      AnyVar ProximalRadioUlnar_DorsoVolarForce = ....Right.ShoulderArm.Joints.ProximalRadioUlnarJoint.ReacForce.Fout[1];
      // ulna ps2Reac ref

      /// Distal Positive
      AnyVar RadioHumeral_ProximoDistalForce = ....Right.ShoulderArm.Joints.HumeroRadialJoint.ReacForce.Fout[0];
      // radius ps2Reac ref

      /// Ulnar positive
      AnyVar DistalRadioUlnar_RadialForce = ....Right.ShoulderArm.Joints.DistalRadioUlnarJoint.Constraints.Reaction.Fout[0];
      /// Volar positive
      AnyVar DistalRadioUlnar_DorsoVolarForce = ....Right.ShoulderArm.Joints.DistalRadioUlnarJoint.Constraints.Reaction.Fout[1];
      // ulna us ref

      // Ulnar positive
      #ifndef WRIST_EXPERIMENTAL
      AnyVar WristRadioCarpal_RadialForce = ....Right.ShoulderArm.Joints.WristJointFlexion.Constraints.Reaction.Fout[1];
      /// Proximal positive
