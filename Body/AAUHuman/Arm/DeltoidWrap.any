    sRel= P1;
    ARel=RotMat(sRel,P2,P3)*RotMat(pi/2,y);

    AnySurfCylinder cyl = {
//      Radius= vnorm(.P2-.P3)*1.3;
Radius= .....DeltoidWrappingPosterior.WrappingSegment.AlignmentRefNode.Deltoid_Scapula_Cyl.cyl.Radius*0.99;
      Length= vnorm(.sRel-.P2);//vnorm(.P4-.P5);//
      CapRatio=1;
