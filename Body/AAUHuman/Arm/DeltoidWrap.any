
AnyFolder DeltoidWrappingPosterior = {
  
    WrappingSegment1.Scapula={
    AnyRefNode gh_rotated1={
      sRel=.gh.sRel;
      ARel={{......Sign*1,0,0},{0,1,0},{0,0,......Sign*1}};
    };
  };

  WrappingSegment1.Humerus={
    AnyRefNode gh_rotated1={
      sRel=.gh.sRel;
      ARel={{1,0,0},{0,......Sign*1,0},{0,0,......Sign*1}};
    };
  };
  
  AnySeg WrappingSegment1 ={
    //^ Segment on which the wrapping cylinders are placed.
    //^ The ssegment follows scapula kinematically, but is dynamically
    //^ attached to both scapula and humerus to ensure that forces on
    //^ the wrapping cylinders are distributed correctly between humerus
    //^ scapula

    Mass=1e-5;
    Jii={0.0,0.0,0.0};

    r0= {-0.128606, 1.650961, 0.1448542};//(O_DeltoideusPosterior2.r heigh 1.95 

    AnySeg &Scapula = ....Segments.Scapula;
    AnySeg &Humerus = ....Segments.Humerus;
    AnySeg &Clavicula = ....Segments.Clavicula;

AnySurfEllipsoid DP1_3nodes = 
{
  AnyRefNode &ScapulaNode = .Scapula.O_DeltoideusPosterior1;
  AnyRefNode &HumerusNode = .Humerus.I_DeltoideusPosterior1;
  AnyRefNode &ThirdNode = .Scapula.I_LevatorScapulae1;
  AdjustorDirection = {1,-0.5,0};
  ARel = RotMatrix * RotMat(pi,x);
  DistanceRatio = 1.2;
  #include "CalEllipsMembers_3nodes.any"
};
AnySurfEllipsoid DP2_3nodes = 
{
  AnyRefNode &ScapulaNode = .Scapula.O_DeltoideusPosterior2;
  AnyRefNode &HumerusNode = .Humerus.I_DeltoideusPosterior2;
  AnyRefNode &ThirdNode = .Scapula.I_LevatorScapulae1;
  AdjustorDirection = {1,-0.3,0};
  ARel = RotMatrix * RotMat(pi,x);
  DistanceRatio = 1.2;
  #include "CalEllipsMembers_3nodes.any"
};
AnySurfEllipsoid DP3_3nodes = 
{
  AnyRefNode &ScapulaNode = .Scapula.O_DeltoideusPosterior3;
  AnyRefNode &HumerusNode = .Humerus.I_DeltoideusPosterior3;
  AnyRefNode &ThirdNode = .Scapula.O_DeltoideusLateral1;
  AdjustorDirection = {1,0.3,0};
  DistanceRatio = 1.2;
  #include "CalEllipsMembers_3nodes.any"
};
AnySurfEllipsoid DP4_3nodes = 
{
  AnyRefNode &ScapulaNode = .Scapula.O_DeltoideusPosterior4;
  AnyRefNode &HumerusNode = .Humerus.I_DeltoideusPosterior4;
  AnyRefNode &ThirdNode = .Scapula.O_DeltoideusLateral1;
  AdjustorDirection = {0.8,0.3,0};
  #include "CalEllipsMembers_3nodes.any"
};

AnyRefNode LocalReferenceFrame_ConstraintNode = {sRel= {0,0,0}; ARel= .Scapula.Axes0;};
AnyRefNode DeltoideusPosteriorWrappingRotNode = {sRel= {0,0,0};
  ARel = .Scapula.Axes0* .Scapula.gh_rotated1.ARel;};

AnyRefNode O_DeltoideusPosterior1 = {sRel= .Scapula.r0 -.r0 + (.Scapula.Axes0 * .....Segments.Scapula.O_DeltoideusPosterior1.sRel')';};
AnyRefNode O_DeltoideusPosterior4 = {sRel= .Scapula.r0 -.r0 + (.Scapula.Axes0 * .....Segments.Scapula.O_DeltoideusPosterior4.sRel')';};
AnyRefNode gh_joint = {sRel= .Scapula.r0 -.r0 + (.Scapula.Axes0 * .....Segments.Scapula.gh_rotated1.sRel')';};
AnyRefNode HumerusLateral = {sRel= .Humerus.r0 -.r0 + (.Humerus.Axes0 * .....Segments.Humerus.TeresMinorhumurus_wrap.sRel')';};
AnyRefNode HumerusAnterior = {sRel= .Humerus.r0 -.r0 + (.Humerus.Axes0 * .....Segments.Humerus.I_Subscapularis3.sRel')';};
AnyRefNode HumerusMedial = {sRel= .Scapula.r0 -.r0 + (.Scapula.Axes0 * .....Segments.Scapula.GHReactionCenterNodeRotated.sRel')'+ 
  (.Scapula.Axes0 *.....Segments.Scapula.GHReactionCenterNodeRotated.ARel* .....Segments.Scapula.GHReactionCenterNodeRotated.CavityEdgeNode8.sRel')';};
};

AnyKinLinear m_O_DeltoideusPosterior1 = {
  AnyRefNode &ref1 = .WrappingSegment1.O_DeltoideusPosterior1; 
  AnyRefNode &ref2 = ....Segments.Scapula.O_DeltoideusPosterior1; 
  Ref=0;
  AnyDrawPLine drw ={Thickness=0.0025;};   
  ref1= {AnyDrawRefFrame drw1 ={RGB={1,0,0};ScaleXYZ={1,1,1}*0.01;};};      
  ref2= {AnyDrawRefFrame drw2 ={RGB={0,0,1};ScaleXYZ={1,1,1}*0.01;};};      
};
AnyKinLinear m_O_DeltoideusPosterior4 = {
  AnyRefNode &ref1 = .WrappingSegment1.O_DeltoideusPosterior4; 
  AnyRefNode &ref2 = ....Segments.Scapula.O_DeltoideusPosterior4; 
  Ref=0;
  AnyDrawPLine drw ={Thickness=0.0025;};   
  ref1= {AnyDrawRefFrame drw1 ={RGB={1,0,0};ScaleXYZ={1,1,1}*0.01;};};      
  ref2= {AnyDrawRefFrame drw2 ={RGB={0,0,1};ScaleXYZ={1,1,1}*0.01;};};      
};

AnyKinLinear m_gh_joint = {
    AnyRefNode &ref1 = .WrappingSegment1.gh_joint; 
    AnyRefNode &ref2=....Segments.Humerus.gh;
    Ref=0;
  AnyDrawPLine drw ={Thickness=0.0025;};   
  ref1= {AnyDrawRefFrame drw1 ={RGB={1,0,0};ScaleXYZ={1,1,1}*0.01;};};      
  ref2= {AnyDrawRefFrame drw2 ={RGB={0,0,1};ScaleXYZ={1,1,1}*0.01;};};      
};

AnyKinLinear HumerusLateral = {
    AnyRefNode &ref1 = .WrappingSegment1.HumerusLateral; 
    AnyRefNode &ref2=....Segments.Humerus.TeresMinorhumurus_wrap;
    Ref=0;
  AnyDrawPLine drw ={Thickness=0.0025;};   
  ref1= {AnyDrawRefFrame drw1 ={RGB={1,0,0};ScaleXYZ={1,1,1}*0.01;};};      
  ref2= {AnyDrawRefFrame drw2 ={RGB={0,0,1};ScaleXYZ={1,1,1}*0.01;};};      
};
AnyKinLinear HumerusAnterior = {
    AnyRefNode &ref1 = .WrappingSegment1.HumerusAnterior; 
    AnyRefNode &ref2=....Segments.Humerus.I_Subscapularis3;
    Ref=0;
  AnyDrawPLine drw ={Thickness=0.0025;};   
  ref1= {AnyDrawRefFrame drw1 ={RGB={1,0,0};ScaleXYZ={1,1,1}*0.01;};};      
  ref2= {AnyDrawRefFrame drw2 ={RGB={0,0,1};ScaleXYZ={1,1,1}*0.01;};};      
};
AnyKinLinear HumerusMedial = {
    AnyRefNode &ref1 = .WrappingSegment1.HumerusMedial; 
    AnyRefNode &ref2= ....Segments.Scapula.GHReactionCenterNodeRotated.CavityEdgeNode8;
    Ref=0;
  AnyDrawPLine drw ={Thickness=0.0025;};   
  ref1= {AnyDrawRefFrame drw1 ={RGB={1,0,0};ScaleXYZ={1,1,1}*0.01;};};      
  ref2= {AnyDrawRefFrame drw2 ={RGB={0,0,1};ScaleXYZ={1,1,1}*0.01;};};      
};


AnyKinEq Constraint = {
  RigidBodyAverageMeasure CombinationMeasure(ROTATIONAL=On, LINEAR=On,POWER =1) = { 
    
    LocalReferenceFrame = &..WrappingSegment1.LocalReferenceFrame_ConstraintNode;
    InputMeasures = {
      &..m_O_DeltoideusPosterior1,
      &..m_O_DeltoideusPosterior4,
      &..m_gh_joint,
      &..HumerusLateral,
      &..HumerusAnterior,
      &..HumerusMedial,
    };
    WeightCoefficients = {20,20,5,5,5,5};
  };
  Reaction.Type ??= repmat(nDim, Off);
  
  //    MeasureOrganizer = {0,1,2}; 
};
  
AnyReacForce ForceToGHJoint = {
  AnyKinLinear lin ={
    AnyRefNode &ref1=.....Segments.Humerus.gh ;
    AnyRefNode &ref2=..WrappingSegment1.gh_joint;
    Ref = 0;
  };
};

AnyReacForce MomentsToScapula1 = {
  AnyKinRotational rot ={
    AnyRefFrame &ref1=..WrappingSegment1;
    AnyRefFrame &ref2=.....Segments.Scapula;
    Type=RotVector;
    AngVelOnOff=On;
  };
};

};



