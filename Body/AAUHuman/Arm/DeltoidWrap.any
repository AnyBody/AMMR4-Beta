AnySurfEllipsoid DL4_3nodes = 
{
  AnyRefNode &ScapulaNode = .Scapula.O_DeltoideusLateral4;
  AnyRefNode &HumerusNode = .Humerus.I_DeltoideusLateral4;
  AnyRefNode &ThirdNode = .Scapula.gh_rotated1;
  AdjustorDirection = {0.8,0.3,0};
  RotMatrix = RotMat(hum_pos, sca_pos, third_pos) * RotMat(AngleX,x) * RotMat(AngleY,y);
  #include "CalEllipsMembers_3nodes.any"
};





