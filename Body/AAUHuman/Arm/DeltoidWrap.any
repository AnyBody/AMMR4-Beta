AnyRefNode AlignmentRefNode = {
  ARel = .ScapulaRef.Axes0;
AnyRefNode p1 = {sRel=.Deltoid_Clavicula_Cyl.P1;};  
AnyRefNode p2 = {sRel=.Deltoid_Clavicula_Cyl.P2;};  
AnyRefNode p3 = {sRel=.Deltoid_Clavicula_Cyl.P3;};  
