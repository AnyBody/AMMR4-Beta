  ARel = RotMatrix * RotMat(pi,x);
  DistanceRatio = 1.3;
  #include "CalEllipsMembers_3nodes.any"
};









AnyRefNode LocalReferenceFrame_ConstraintNode = {sRel= {0,0,0}; ARel= .Scapula.Axes0;};
AnyRefNode DeltoideusPosteriorWrappingRotNode = {sRel= {0,0,0};
  ARel = .Scapula.Axes0* .Scapula.gh_rotated1.ARel;};

AnyRefNode O_DeltoideusPosterior1 = {sRel= .Scapula.r0 -.r0 + (.Scapula.Axes0 * .....Segments.Scapula.O_DeltoideusPosterior1.sRel')';};
AnyRefNode O_DeltoideusPosterior4 = {sRel= .Scapula.r0 -.r0 + (.Scapula.Axes0 * .....Segments.Scapula.O_DeltoideusPosterior4.sRel')';};
AnyRefNode gh_joint = {sRel= .Scapula.r0 -.r0 + (.Scapula.Axes0 * .....Segments.Scapula.gh_rotated1.sRel')';};
AnyRefNode HumerusLateral = {sRel= .Humerus.r0 -.r0 + (.Humerus.Axes0 * .....Segments.Humerus.TeresMinorhumurus_wrap.sRel')';};
AnyRefNode HumerusAnterior = {sRel= .Humerus.r0 -.r0 + (.Humerus.Axes0 * .....Segments.Humerus.I_Subscapularis3.sRel')';};
AnyRefNode HumerusMedial = {sRel= .Scapula.r0 -.r0 + (.Scapula.Axes0 * .....Segments.Scapula.GHReactionCenterNodeRotated.sRel')'+ 
  (.Scapula.Axes0 *.....Segments.Scapula.GHReactionCenterNodeRotated.ARel* .....Segments.Scapula.GHReactionCenterNodeRotated.CavityEdgeNode8.sRel')';};

AnyRefNode O_DeltoideusLateral1 = {sRel= .Scapula.r0 -.r0 + (.Scapula.Axes0 * .....Segments.Scapula.O_DeltoideusLateral1.sRel')';};
AnyRefNode O_DeltoideusLateral4 = {sRel= .Scapula.r0 -.r0 + (.Scapula.Axes0 * .....Segments.Scapula.O_DeltoideusLateral4.sRel')';};

};

