//      axes_node2 = .ClaviculaRef.Axes0 * Node2.ARel;
////      AdjustorDirection = {1,.....Sign*0.2,0};
//      AdjustorXRotation = 3*pi/2;
////      DistanceRatio = 1.25;
//    #include "CalEllipsMembers_3nodes.any"
