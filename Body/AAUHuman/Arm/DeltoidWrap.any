  AnyRefNode &ThirdNode = .Scapula.O_DeltoideusLateral3;
  sca_pos =  .Clavicula.r0 + (.Clavicula.Axes0 * ScapulaNode.sRel')'-.r0;//{-0.10172724902296945, 1.6883496271880594, 0.12329763022732207}-.r0;//
  sca_axes = .Clavicula.Axes0 * ScapulaNode.ARel;
