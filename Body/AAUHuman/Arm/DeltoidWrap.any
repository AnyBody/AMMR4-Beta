AnyRevoluteJoint Revolute_WrappingSegment_RepresentDeltoidLateral = {
  Axis = x;
  AnyRefFrame &Scapula = .WrappingSegment_RepresentDeltoidLateral.ScapulaRef.O_DeltoideusLateralMid_Aligned;
  AnyRefFrame &wrappingSeg = .WrappingSegment_RepresentDeltoidLateral.O_DeltoideusLateralMid_Aligned;
};


////-------------------------------------------------------Fix to Scapula
  AnyKinEqSimpleDriver WrappingSegment_RepresentDeltoidLateral_FixToScapula ={
  AnyKinLinear lin = {
    Ref=0;
    AnyRefFrame &LayerNode = ..WrappingSegment_RepresentDeltoidLateral.ScapulaRef.gh_tilted;
    AnyRefNode &ref=..WrappingSegment_RepresentDeltoidLateral.gh_joint_tilted; 
  };
  MeasureOrganizer ={0};
    DriverPos =repmat(nDim,0);
    DriverVel =repmat(nDim,0);
    Reaction.Type ??=repmat(nDim,Off);
  }; 







