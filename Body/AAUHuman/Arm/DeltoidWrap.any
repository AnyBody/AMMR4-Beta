  AnyRefNode &ref1 = .WrappingSegment1.O_DeltoideusPosterior1; 
  AnyRefNode &ref2 = ....Segments.Scapula.O_DeltoideusPosterior1; 
  Ref=0;
  AnyDrawPLine drw ={Thickness=0.0025;};   
  ref1= {AnyDrawRefFrame drw1 ={RGB={1,0,0};ScaleXYZ={1,1,1}*0.01;};};      
