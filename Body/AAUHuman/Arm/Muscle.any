MuscleGroup TrapeziusScapular() = {
  AnyMuscleShortestPath  TrapeziusScapular1 = {
    AnyMuscleModel &MusMdl =  ...MuscleModels.TrapeziusScapular1;
    AnyRefNode &Org = ..TrunkNodeAttachement.T12Seg.O_TrapeziusScapular1;
    AnyRefNode &Ins = ...Segments.Scapula.I_TrapeziusScapular1;
    viewMuscle = {#include "../DrawSettings/MusDrawSettings.any"};
    SPLine.StringMesh = 100;
    AnySurfCylinder &Surf = ..margo_medialis;
    SPLine = {
      AnyMatrix InitWrapPos = { transf3D({1.3*.Surf.Radius, 0,0.5*.Surf.Length}, &.Surf)};
      InitWrapPosVecArr = {&InitWrapPos};
    };
