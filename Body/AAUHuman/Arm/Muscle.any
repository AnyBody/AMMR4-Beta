        transf3D({-.Surf1.Radius[0],0*.Surf1.Radius[1],....Sign*0.4*.Surf1.Radius[2]}, &.Surf1),
        transf3D( {....Sign*1.4*.Surf4.Radius, -1.4*.Surf4.Radius, 0.85*.Surf4.Length}, &.Surf4),
        transf3D({1.2*.Surf3.Sizes[0],0,0},  &...LatissimusDorsiWrapping.BASE_FRAME.Wrapping_1.Center),
        transf3D({0, ....Sign*-3*.Surf2.Radius,0.8*.Surf2.Length}, &.Surf2)
      };
