MuscleGroup BicepsBrachiiBreve = {
  AnyMuscleShortestPath  BicepsBrachiiBreve = {
    AnyMuscleModel &MusMdl = ...MuscleModels.BicepsBrachiiBreve;
    AnyRefNode &Org = ...Segments.Scapula.O_BicepsBrachiiBreve;
    AnyRefNode &Ins = ...Segments.Radius.I_Biceps_SH ;
    viewMuscle = {#include "../DrawSettings/MusDrawSettings.any"};
    SPLine.StringMesh = 200;
    AnySurfCylinder &Surf0 = ..condylus_hum;
    AnySurfCylinder &Surf3 = ..bicepscyl;
    AnySurfEllipsoid &Surf4 = ..art_gh_humRef;
    SPLine.InitWrapPosVecArr = { &..BicepsBrachiiLongum.BicepsBrachiiLongum.SPLine.InitWrapPos };
  };
};
MuscleGroup BicepsBrachiiLongum = {
  AnyMuscleShortestPath BicepsBrachiiLongum = {
    AnyMuscleModel &MusMdl = ...MuscleModels.BicepsBrachiiLongum;

    AnyRefNode &Org = ...Segments.Scapula.O_BicepsBrachiiLongum;//this point has been taken from VU study
    AnyRefNode &Via1 = ...Segments.Humerus.sulcus_intertubercularisTop;
    AnyRefNode &Via2 = ...Segments.Humerus.sulcus_intertubercularis;
    AnyRefNode &Ins = ...Segments.Radius.I_Biceps_LH;  //this point has been taken from MAYO study

    viewMuscle = {#include "../DrawSettings/MusDrawSettings.any"};
    SPLine.StringMesh = 150;
    AnySurfEllipsoid &Surfgh = ..art_gh_humRef;
    AnySurfCylinder &Surf0 = ..condylus_hum;
    AnySurfCylinder &Surf3 = ..bicepscyl;

    SPLine = {
      RelTol = 1e-6;
      AbsTol = 1e-5;
      AnyMatrix InitWrapPos = {
            transf3D(.Surf0.Radius*{0.5,0,....Sign*1.2}, &....Segments.Humerus.fe),
            transf3D({....Sign*-1.1*.Surf0.Radius,1*.Surf0.Radius, 0.45*.Surf0.Length }, &.Surf0 ),
            transf3D({ 0, 0  , 2*.Surf3.Radius }, &....Segments.Ulna.I_Brachialis_1),
            transf3D({ ....Sign*1*.Surf3.Radius,   -1*.Surf3.Radius, 0.65*.Surf3.Length }, &.Surf3)

      };
      InitWrapPosVecArr = { None,None, &InitWrapPos };
    };
  };
};

