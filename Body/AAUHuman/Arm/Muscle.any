AnyFolder Pectoralis_minor1_cyl={

  AnyFolder& pectoralis_ref =  .TrunkNodeAttachement.R3Seg.O_pectoralis_minor_1;
  pectoralis_ref = {
    AnyRefNode PectoralisWrapAttachement = {
      ARel = RotMat(-pi/2,x)*RotMat(pi/5*....Sign, x);
    };
  };
  #include "WrapperCyl.any"
  Cylinder = {
    LengthScale = 2.3;
    ScaleFactor = (
      vnorm(...Segments.Humerus.Data.I_subscapularis_1_pos - ...Segments.Humerus.Data.I_subscapularis_5_pos) /
      vnorm(...Segments.Humerus.I_subscapularis_1.sRel - ...Segments.Humerus.I_subscapularis_5.sRel)
    );
    Segment.Axes0 = ..TrunkNodeAttachement.R3Seg.Axes0 * RotMat(-pi/2,x)*RotMat(pi/5*...Sign,x)*RotMat(-0.25,y);
    Segment.r0 = ..TrunkNodeAttachement.R3Seg.r0 + ..TrunkNodeAttachement.R3Seg.O_pectoralis_minor_1.sRel*..TrunkNodeAttachement.R3Seg.Axes0';
    AnyRefNode &StartNode = .pectoralis_ref.PectoralisWrapAttachement;
    AnyRefNode &EndNode = ...Segments.Scapula.I_pectoralis_minor_1;
  };
};

