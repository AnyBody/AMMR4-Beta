// This file contains muscle attachment points for the clavicle segment data from VU sub 2.
// The original coordinates have been transformed from global coordinates to the segment local
// coordinate system
AnyFolder &Clavicula =.Segments.Clavicula;

Clavicula = {

  #include "../DrawSettings/SegmentAxes.any"
  #if BM_ARM_DELTOID_WRAPPING == _DELTOID_WRAPPING_RAKE_
  AnyRefNode O_deltoideus_clavicular_part_1       = {sRel = .Scale(.Data.O_deltoideus_clavicular_part_1_pos*.Mirror);};
  AnyRefNode O_deltoideus_clavicular_part_2       = {sRel = .Scale(.Data.O_deltoideus_clavicular_part_2_pos*.Mirror);};
  AnyRefNode O_deltoideus_clavicular_part_3       = {sRel = .Scale(.Data.O_deltoideus_clavicular_part_3_pos*.Mirror);};
  AnyRefNode O_deltoideus_clavicular_part_4       = {sRel = .Scale(.Data.O_deltoideus_clavicular_part_4_pos*.Mirror);};
  AnyRefNode O_deltoideus_clavicular_part_5       = {sRel = .Scale(.Data.O_deltoideus_clavicular_part_5_pos*.Mirror);};
  AnyRefNode O_deltoideus_clavicular_part_6       = {sRel = .Scale(.Data.O_deltoideus_clavicular_part_6_pos*.Mirror);};
  #else
  AnyRefNode O_deltoideus_anterior_part_1       = {sRel = .Scale(.Data.O_deltoideus_anterior_part_1_pos*.Mirror);};
  AnyRefNode O_deltoideus_anterior_part_2       = {sRel = .Scale(.Data.O_deltoideus_anterior_part_2_pos*.Mirror);};
  AnyRefNode O_deltoideus_anterior_part_3       = {sRel = .Scale(.Data.O_deltoideus_anterior_part_3_pos*.Mirror);};
  AnyRefNode O_deltoideus_anterior_part_4       = {sRel = .Scale(.Data.O_deltoideus_anterior_part_4_pos*.Mirror);};
  #endif

  AnyRefNode O_pectoralis_major_clavicular_part_1 = {sRel = .Scale(.Data.O_pectoralis_major_clavicular_part_1_pos*.Mirror);};
  AnyRefNode O_pectoralis_major_clavicular_part_2 = {sRel = .Scale(.Data.O_pectoralis_major_clavicular_part_2_pos*.Mirror);};
  AnyRefNode O_pectoralis_major_clavicular_part_3 = {sRel = .Scale(.Data.O_pectoralis_major_clavicular_part_3_pos*.Mirror);};
  AnyRefNode O_pectoralis_major_clavicular_part_4 = {sRel = .Scale(.Data.O_pectoralis_major_clavicular_part_4_pos*.Mirror);};
  AnyRefNode O_pectoralis_major_clavicular_part_5 = {sRel = .Scale(.Data.O_pectoralis_major_clavicular_part_5_pos*.Mirror);};

  AnyRefNode I_TrapeziusClavicularC5        = {sRel = .Scale(.Data.I_TrapeziusClavicularC5_pos*.Mirror);};
  AnyRefNode I_TrapeziusClavicularC4        = {sRel = .Scale(.Data.I_TrapeziusClavicularC4_pos*.Mirror);};
  AnyRefNode I_TrapeziusClavicularC3        = {sRel = .Scale(.Data.I_TrapeziusClavicularC3_pos*.Mirror);};
  AnyRefNode I_TrapeziusClavicularC2        = {sRel = .Scale(.Data.I_TrapeziusClavicularC2_pos*.Mirror);};
  AnyRefNode I_TrapeziusClavicularC1        = {sRel = .Scale(.Data.I_TrapeziusClavicularC1_pos*.Mirror);};
  AnyRefNode I_TrapeziusClavicularSkull        = {sRel = .Scale(.Data.I_TrapeziusClavicularSkull_pos*.Mirror);};

  AnyRefNode SternocleidomastoidNode = {sRel = .Scale(.Data.SternocleidomastoidNode_pos*.Mirror);};
};
