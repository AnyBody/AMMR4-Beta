// Define ellipsoid's raduis, sRel, and ARel based on center points of insertion nodes
AnyFloat hum_pos = .Humerus.r0 + (.Humerus.Axes0 * HumerusNode.sRel')'-.r0;//{-0.05129888, 1.514227, 0.2018746}-.r0; //
AnyFloat hum_axes = .Humerus.Axes0 * HumerusNode.ARel;
AnyFloat sca_pos =  .Scapula.r0 + (.Scapula.Axes0 * ScapulaNode.sRel')'-.r0;//{-0.10172724902296945, 1.6883496271880594, 0.12329763022732207}-.r0;//
AnyFloat sca_axes = .Scapula.Axes0 * ScapulaNode.ARel;

AnyFloat Rxy ??= vnorm( (sca_pos - hum_pos) )/4;
AnyFloat Rz = Rxy*5;
AnyFloat DistanceRatio ??= 1;
AnyFloat AdjustorDirection ??= {1,0,0};
Radius = {Rxy, Rxy, Rz};
AnyFloat Sizes = Radius;
AnyFloat AngleX ??= 0*pi/180;
AnyMatrix RotMatrix = RotMat(hum_pos, sca_pos, (sca_axes*{0,0,-0.01}')'+sca_pos) * RotMat(AngleX,x);
sRel ??= (sca_pos + hum_pos)/2 + Rxy*DistanceRatio * (RotMatrix*(AdjustorDirection/vnorm(AdjustorDirection))')';
ARel ??= RotMatrix;

