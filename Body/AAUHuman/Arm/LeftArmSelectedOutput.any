
SelectedOutput.Left = {

  AnyFolder ShoulderArm = {

    SelectedOutputGroup JointReactionForce = {

      /// Medial positive
      AnyVar SternoClavicular_MedioLateralForce = ....Left.ShoulderArm.Joints.SternoClavicularJoint.Constraints.Reaction.Fout[0];
      /// Superior positive
      AnyVar SternoClavicular_InferoSuperiorForce = ....Left.ShoulderArm.Joints.SternoClavicularJoint.Constraints.Reaction.Fout[1];
      /// Posterior positive
      AnyVar SternoClavicular_AnteroPosteriorForce = ....Left.ShoulderArm.Joints.SternoClavicularJoint.Constraints.Reaction.Fout[2];

      /// Lateral positive
      AnyVar AcromioClavicular_MedioLateralForce = ....Left.ShoulderArm.Joints.AcromioClavicularJoint.Constraints.Reaction.Fout[0];
      /// Inferior positive
      AnyVar AcromioClavicular_InferoSuperiorForce = ....Left.ShoulderArm.Joints.AcromioClavicularJoint.Constraints.Reaction.Fout[1];
      /// Posterior positive
