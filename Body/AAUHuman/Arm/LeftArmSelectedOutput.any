      /// Wrist Abduction angle in degrees
      AnyVar WristAbduction = ....Interface.Left.WristAbduction.Pos[0] * 180/pi;
    };


    AnyFolder Muscles = {
      AnySearchFun MuscleList = {
        Search =
        #if BM_ARM_MUSCLES_LEFT == OFF
         ".....Left.ShoulderArm.JointMuscles.*.*.dof0.Muscle.*.Activity";
        #else
