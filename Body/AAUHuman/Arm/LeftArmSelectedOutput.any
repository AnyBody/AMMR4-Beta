      AnyVar ElbowFlexion = ....Interface.Left.ElbowFlexion.Pos[0] * 180/pi;
      /// Elbow Pronation angle in degrees
      AnyVar ElbowPronation = ....Interface.Left.ElbowPronation.Pos[0] * 180/pi;
