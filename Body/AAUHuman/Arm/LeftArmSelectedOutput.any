      // Clavicula acj ref

      /// Distraction positive
      AnyVar GlenoHumeral_DistractionForce = (1)*....Left.ShoulderArm.Joints.GHReactions.ResultantForce.FTotalLocal[2];
      /// Inferior positive
      AnyVar GlenoHumeral_InferoSuperiorForce = (-1)*....Left.ShoulderArm.Joints.GHReactions.ResultantForce.FTotalLocal[1];
      /// Posterior positive
      AnyVar GlenoHumeral_AnteroPosteriorForce = ....Left.ShoulderArm.Joints.GHReactions.ResultantForce.FTotalLocal[0];
      // scapula gh ref

