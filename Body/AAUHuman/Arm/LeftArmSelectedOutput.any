    /// Joint angles in degrees
    SelectedOutputGroup JointAngles = {
      /// Sterno Clavicular Protraction angle in degrees
      AnyVar SternoClavicularProtraction = ....Interface.Left.SternoClavicularProtraction.Pos[0] * 180/pi;
      /// Sterno Clavicular Elevation angle in degrees
