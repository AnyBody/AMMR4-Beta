
AnyFolder &Trunk=..Trunk;
//Right leg
Segments.Thigh.Axes0  ??=
Trunk.Segments.PelvisSeg.Axes0*HipNodeRef.RotNode.ARel
* RotMat((pi/180)*.JointPos.HipFlexion,z)
* RotMat((pi/180)*.JointPos.HipExternalRotation,y)
* RotMat((pi/180)*.JointPos.HipAbduction,x)
* Segments.Thigh.HipJoint.RotNode.ARel';


//shank
Segments.Shank.Axes0  ??=
Segments.Thigh.Axes0*
Segments.Thigh.KneeJoint.ARel*
Segments.Thigh.KneeJoint.RotNode.ARel*
RotMat((-pi/180)*.JointPos.KneeFlexion,z)*
Segments.Shank.KneeJoint.RotNode.ARel'*
Segments.Shank.KneeJoint.ARel';

#if BM_FOOT_MODEL == _FOOT_MODEL_LEG_FOOT_
//Foot
Segments.Foot.Axes0  ??=
Segments.Shank.Axes0*
Segments.Shank.AnkleJoint.ARel*
Segments.Shank.AnkleJoint.RotNode.ARel*
RotMat((-pi/180)*.JointPos.AnklePlantarFlexion ,z)*
RotMat((pi/180)*.JointPos.SubTalarEversion ,y)*
Segments.Foot.AnkleJoint.RotNode.ARel'*
Segments.Foot.AnkleJoint.ARel';
#endif
