    AnyRefNode &TalusNode = ...Segments.Foot.Talus.TaloNavicularJoint.RotNode;
    AnyRefNode &NavicularNode = ...Segments.Foot.Navicular.TaloNavicularJoint.RotNode;
    AngVelOnOff = On;
    Type=RotAxesAngles;
  };
  MeasureOrganizer={0};//z
};
AnyKinMeasureOrg TaloNavicularAbductionJntMus = {
