


//Talus
Segments.Foot.Talus.Axes0  ??=
Segments.Shank.Axes0*
Segments.Shank.AnkleJoint.ARel*
RotMat((-pi/180)*.JointPos.AnklePlantarFlexion ,z)*
Segments.Foot.Talus.AnkleJoint.ARel';


//RigidPart
Segments.Foot.RigidPart.Axes0  ??=
Segments.Foot.Talus.Axes0*
Segments.Foot.Talus.SubTalarJoint.ARel*
RotMat((pi/180)*.JointPos.SubTalarEversion ,z)*
Segments.Foot.SubTalarJoint.ARel';


//Toes
Segments.Foot.Toe1.Axes0  ??=
Segments.Foot.Metatarsal1.Axes0*
Segments.Foot.Metatarsal1.MtPhalJoint.ARel*
Segments.Foot.Metatarsal1.MtPhalJoint.RotNode.ARel*
RotMat((pi/180)*.JointPos.Foot.MetatarsoPhalangeal1DorsiFlexion,z)*
RotMat((pi/180)*.JointPos.Foot.MetatarsoPhalangeal1Abduction,y)*
Segments.Foot.ProximalPhalange1.MtPhalJoint.RotNode.ARel'*
Segments.Foot.ProximalPhalange1.MtPhalJoint.ARel';


