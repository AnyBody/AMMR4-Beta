RotMat((pi/180)*.JointPos.Foot.MetatarsoPhalangeal3Abduction,y)*
Segments.Foot.ProximalPhalange3.MtPhalJoint.RotNode.ARel'*
Segments.Foot.ProximalPhalange3.MtPhalJoint.ARel';


