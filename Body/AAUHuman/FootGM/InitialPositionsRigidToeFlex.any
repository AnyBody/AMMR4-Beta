RotMat((pi/180)*.JointPos.Foot.MetatarsoPhalangeal2Abduction,y)*
Segments.Foot.ProximalPhalange2.MtPhalJoint.RotNode.ARel'*
Segments.Foot.ProximalPhalange2.MtPhalJoint.ARel';


