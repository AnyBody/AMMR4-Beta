


//Talus
Segments.Foot.Talus.Axes0 = 
Segments.Shank.Axes0*
Segments.Shank.AnkleJoint.ARel*
RotMat((-pi/180)*.JointPos.AnklePlantarFlexion ,z)*
Segments.Foot.Talus.AnkleJoint.ARel';


//RigidPart
Segments.Foot.RigidPart.Axes0 = 
Segments.Foot.Talus.Axes0*
Segments.Foot.Talus.SubTalarJoint.ARel*
RotMat((pi/180)*.JointPos.SubTalarEversion ,z)*
Segments.Foot.SubTalarJoint.ARel';