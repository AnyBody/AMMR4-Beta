LegCalibrationStudy RightCal1Hip(
  BodyModelRef=Main.HumanModel.BodyModel,
  Side=Right,
) = {
  nStep = NumElemOf(HipPositions);
  
  MuscleArr = ObjSearch(
    &..BodyModel.Right.Leg.Mus,
    {
      "AdductorBrevis*.*",
      "AdductorLong*.*",
      "AdductorMagnus*.*",
      "Gemellus.*",
      "Gluteus*.*",
      "Iliacus*.*",
      "Obturator*.*",
      "Pectineus.*",
      "Piriformis.*",
      "QuadratusFemoris.*",
    }, 
    "AnyMuscle"
  );
  
  RminMuscleFiber = repmat(NumElemOf(MuscleArr), .RValues.RMinDefault);
  RmaxMuscleFiber = repmat(NumElemOf(MuscleArr), .RValues.RMaxDefault);

  HipPositions = repmat(2, flattenptr(&.RangeOfMotion.Right.Leg.Hip.ActiveRoM));
  KneePositions = repmat(nStep, &.RangeOfMotion.Right.Leg.Knee.Neutral);
  AnklePositions = repmat(nStep, &.RangeOfMotion.Right.Leg.Ankle.Neutral);
  SubTalarPositions = repmat(nStep, &.RangeOfMotion.Right.Leg.Ankle.Neutral);
};

