//This is the calibration4 file, it will calibrate specific muscles on the leg
AnyFolder LegCal4={
  AnyComponentDefinition obj = {};

  AnyFolder &Pelvis = ...HumanFolderRef.Trunk.Segments.PelvisSeg;
  AnyFolder &Sacrum = ...HumanFolderRef.Trunk.Segments.SacrumSeg;

  AnyFolder &LegSegSide = .SideHumanFolderRef.Leg.Segments;

  AnyFolder &LegJointsSide = .SideHumanFolderRef.Leg.Joints;
  AnyFolder &SacrumPelvisJnt = ...HumanFolderRef.Trunk.Joints.Lumbar.SacrumPelvis;
  AnyFolder &SacrumPelvisJnt = .SideHumanFolderRef.Leg.Joints;

  AnyFixedRefFrame ground = {
    AnyRefNode node = {
      ARel=..Pelvis.Axes0;
      sRel=..Pelvis.r0;
    };
  };

  AnyRevoluteJoint PelvisGround={
    AnyRefFrame &Ground = .ground.node;
    AnySeg &Sacrum= Main.HumanModel.Right.Leg.Segments.Pelvis;
    Axis=z;
  };

  AnyKinEqSimpleDriver PelvisGroundRot = {
    AnyRevoluteJoint &Jnt = .PelvisGround;
    DriverPos = {0};
    DriverVel = {0};
    Reaction.Type = {Off};
  };

  AnyKinEqSimpleDriver PelvisSacrumFix = {
    AnyKinMeasure& Jnt = .SacrumPelvisJnt;
    DriverPos = {0,0,0};
    DriverVel = {0,0,0};
    Reaction.Type = {Off,Off,Off};
  };

//  AnyKinEqSimpleDriver JntDOFDriver = {
//    AnyKinMeasure& Joint = ..SideHumanFolderRef.Leg.JntDOF;
//    DriverPos = {2.15,0,-1.22,0,0,-1}; //10 degrees plantar flexion
////    DriverPos = {1.,0.0,0,0,0,-1};
//    DriverVel = {0.0,0,0,0,0,0};
//    Reaction.Type = {Off,Off,Off,Off,Off,Off};
//  };//JntDOFDriver

  AnyKinEqSimpleDriver Hip = {
    AnySphericalJoint &Spherical = Main.HumanModel.Right.Leg.Joints.HipRight;
    MeasureOrganizer = {2,0,1}; // flexion/extension, abduction/adduction, internal/external rotation
    DriverPos = {0,-5,0}*pi/180;
    DriverVel = {0,0,0}*pi/180;
    Reaction.Type = {Off,Off,Off};
  };

  AnyKinEqSimpleDriver Knee = {
    AnyRevoluteJoint &Hinge = Main.HumanModel.Right.Leg.Joints.Knee;
    DriverPos = {0*pi/180};
    DriverVel = {0*pi/180};
    Reaction.Type = {Off};
  };

  #if BM_FOOT_MODEL != _FOOT_MODEL_NONE_
  AnyKinEqSimpleDriver Ankle = {
    AnyRevoluteJoint &Hinge = Main.HumanModel.Right.Leg.Joints.Ankle;
    DriverPos = {0*pi/180}; // 10 degrees plantar flexion
    DriverVel = {0*pi/180};
    Reaction.Type = {Off};
  };

  AnyKinEqSimpleDriver SubTalar = {
    AnyRevoluteJoint &Hinge = Main.HumanModel.Right.Leg.Joints.SubTalar;
    DriverPos = {0*pi/180};
    DriverVel = {0*pi/180};
    Reaction.Type = {Off};
  };
  #endif
  // Calibration4 calibrates the following muscles of the lower leg:
  // rectus femoris
  AnyFolder &MuscleParCal4 =.SideHumanFolderRef.Leg.MuscleModels;

  AnyFolder Muscles = {
    AnyMuscleViaPoint &GluteusMinimusAnterior1 =  ..SideHumanFolderRef.Leg.Muscles.GluteusMinimusAnterior1;
    AnyMuscleViaPoint &GluteusMinimusMid1 =  ..SideHumanFolderRef.Leg.Muscles.GluteusMinimusMid1;
    AnyMuscleViaPoint &GluteusMinimusPosterior1 =  ..SideHumanFolderRef.Leg.Muscles.GluteusMinimusPosterior1;
    AnyMuscleViaPoint &GluteusMediusAnterior1 =  ..SideHumanFolderRef.Leg.Muscles.GluteusMediusAnterior1;
    AnyMuscleViaPoint &GluteusMediusAnterior2 =  ..SideHumanFolderRef.Leg.Muscles.GluteusMediusAnterior2;
    AnyMuscleViaPoint &GluteusMediusAnterior3 =  ..SideHumanFolderRef.Leg.Muscles.GluteusMediusAnterior3;
    AnyMuscleViaPoint &GluteusMediusAnterior4 =  ..SideHumanFolderRef.Leg.Muscles.GluteusMediusAnterior4;
    AnyMuscleViaPoint &GluteusMediusAnterior5 =  ..SideHumanFolderRef.Leg.Muscles.GluteusMediusAnterior5;
    AnyMuscleViaPoint &GluteusMediusAnterior6 =  ..SideHumanFolderRef.Leg.Muscles.GluteusMediusAnterior6;
    AnyMuscleViaPoint &GluteusMediusPosterior1 =  ..SideHumanFolderRef.Leg.Muscles.GluteusMediusPosterior1;
    AnyMuscleViaPoint &GluteusMediusPosterior2 =  ..SideHumanFolderRef.Leg.Muscles.GluteusMediusPosterior2;
    AnyMuscleViaPoint &GluteusMediusPosterior3 =  ..SideHumanFolderRef.Leg.Muscles.GluteusMediusPosterior3;
    AnyMuscleViaPoint &GluteusMediusPosterior4 =  ..SideHumanFolderRef.Leg.Muscles.GluteusMediusPosterior4;
    AnyMuscleViaPoint &GluteusMediusPosterior5 =  ..SideHumanFolderRef.Leg.Muscles.GluteusMediusPosterior5;
    AnyMuscleViaPoint &GluteusMediusPosterior6 =  ..SideHumanFolderRef.Leg.Muscles.GluteusMediusPosterior6;

    //Muscle main function: Plantar flexion, different angle w.r.t. LegCal2 due to larger pennation angle
//    AnyMuscleViaPoint &SoleusMedialis1 =  ..SideHumanFolderRef.Leg.Muscles.SoleusMedialis1;
//    AnyMuscleViaPoint &SoleusMedialis2 =  ..SideHumanFolderRef.Leg.Muscles.SoleusMedialis2;
//    AnyMuscleViaPoint &SoleusMedialis3 =  ..SideHumanFolderRef.Leg.Muscles.SoleusMedialis3;
//    AnyMuscleViaPoint &SoleusLateralis1 =  ..SideHumanFolderRef.Leg.Muscles.SoleusLateralis1;
//    AnyMuscleViaPoint &SoleusLateralis2 =  ..SideHumanFolderRef.Leg.Muscles.SoleusLateralis2;
//    AnyMuscleViaPoint &SoleusLateralis3 =  ..SideHumanFolderRef.Leg.Muscles.SoleusLateralis3;
  };

};

// The study: Operations to be performed on the model
AnyBodyCalibrationStudy LegCalibrationStudy4 = {
  AnyFolder &ref=.LegCal4;
  nStep = 1;
  InitialConditions.SolverType = KinSolOverDeterminate;
  InitialConditions.SmallStepAssumptionOnOff = Off;
};
