        AnySearchFun SartoriusForceList =  {
          Search = "......Left.Leg.Muscles.Sartorius.*.Fout";
        };

        // Tensor Fasciae Latae
        AnySearchFun TensorFasciaeForceList =  {
          Search = "......Left.Leg.Muscles.TensorFasciae*.*.Fout";
        };


        // Psoas Major
        AnySearchFun PsoasMajorForceList =  {
          Search = "......Trunk.Muscles.Left.PsoasMajor.*.Fout";
        };


        //        // Psoas Minor
        //        AnySearchFun PsoasMinorForceList =  {
        //          Search = "......Trunk.Leg.Muscles.Left.PsoasMinor.*.Fout";
        //        };

        AnySearchFun IliacusForceList =  {
          Search = "......Left.Leg.Muscles.Iliac*.*.Fout";
        };

        AnySearchFun RectusFemorisForceList =  {
          Search = "......Left.Leg.Muscles.RectusF*.*.Fout";
