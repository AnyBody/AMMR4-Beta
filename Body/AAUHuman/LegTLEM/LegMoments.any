
//This file contains a moment measures for the following joints in the Leg:

//Ankle
//Knee
//Hip

//The measures named:
//AnkleNetMoment
//KneeNetMoment
//HipNetMoment
//will measure the moments and forces supplied by the muscles spanning these and on top of these
//moments and force the forces and moments from the constraints in the joints will be added.
//The resulting force and moment are equal to the to total moment and force which
//could replace both the muscles spanning the joint and the joints reactions.

//The measures named:
//AnkleNetMomentMuscle
//KneeNetMomentMuscle
//HipNetMomentMuscle
//will measure ONLY the moments and forces supplied by the muscles spanning these joint and not the moments and forces which from the constraints in the joints.
//The resulting force and moment are equal to the to total moment and force which
//are supplied by the muscles.

//In both cases the resulting force and moment is given in the global coordinate system.

//A vector which shows the resulting moment as an arrow, will automatically be shown in the model view the parameters of it can
//be controlled from the "DrawSettings.any" file typically to be found in the application directory.,

#if (BM_FOOT_MODEL == _FOOT_MODEL_LEG_FOOT_) | (BM_FOOT_MODEL == _FOOT_MODEL_RIGID_GM_) | (BM_FOOT_MODEL == _FOOT_MODEL_TOE_FLEX_GM_) | (BM_FOOT_MODEL == _FOOT_MODEL_DETAILED_GM_)

AnyForceMomentMeasure2 AnklePlantarFlexionNetMomentMuscle =
{
  AnyRefFrame &ref = ..Segments.Shank.AnkleJoint;
  //RefPoint = &..Segments.Shank.AnkleJoint;
//  IncludeSegments =
//  {
//    &..Segments.Foot, &..Segments.Talus
//  };
  IncludeSegments =
    arrcat(ObjSearch("..Segments.Foot", "AnySeg"),
           ObjSearch("..Segments.Foot.*", "AnySeg"));

  IncludeForces = arrcat(
    ObjSearch("..Muscles.*.*", "AnyMuscle"),
    ObjSearch("..TrunkMuscles.PsoasMajor.*", "AnyMuscle"),
    ObjSearchRecursive("..JointMuscles", "*", "AnyMuscle")
  );
  AnyVec3 Mlocal=M*ref.Axes;
  AnyVar MPlantarFlexion=-Mlocal[2];
};

AnyForceMomentMeasure2 SubTalarEversionNetMomentMuscle =
{
  AnyRefFrame &ref = ..Segments.Talus.SubTalarJoint;
  //RefPoint = &..Segments.Talus.SubTalarJoint;
//  IncludeSegments =
//  {
//    &..Segments.Foot
//  };
  IncludeSegments =
   set_difference(arrcat(ObjSearch("..Segments.Foot", "AnySeg"),
                         ObjSearch("..Segments.Foot.*", "AnySeg")),
                  ObjSearch("..Segments.Foot.Talus", "AnySeg"));

  IncludeForces = arrcat(
    ObjSearch("..Muscles.*.*", "AnyMuscle"),
    ObjSearch("..TrunkMuscles.PsoasMajor.*", "AnyMuscle"),
    ObjSearchRecursive("..JointMuscles", "*", "AnyMuscle")
  );
  AnyVec3 Mlocal=M*ref.Axes;
  AnyVar MSubTalarEversion=Mlocal[2];
};

AnyForceMomentMeasure2 AchillesTendonSubtalarEversion = {
  AnyRefNode &ref=..Segments.Talus.SubTalarJoint;
//  AnySeg &seg=..Segments.Foot;
  IncludeSegments =
   set_difference(arrcat(ObjSearch("..Segments.Foot", "AnySeg"),
                         ObjSearch("..Segments.Foot.*", "AnySeg")),
                  ObjSearch("..Segments.Foot.Talus", "AnySeg"));

  #ifndef LEG_WITH_JOINT_MUSCLES
  IncludeForces = arrcat(
    ObjSearch("..Muscles.*.Soleus*", "AnyMuscle"),
    ObjSearch("..Muscles.*.Gastrocnemius*", "AnyMuscle")
  );
  #endif

  AnyVec3 Mlocal=M*ref.Axes;
  AnyVar MSubTalarEversion=Mlocal[2];
};

AnyForceMomentMeasure2 InversionMusclesSubtalarEversion = {
  AnyRefNode &ref=..Segments.Talus.SubTalarJoint;
//  AnySeg &seg=..Segments.Foot;
  IncludeSegments =
   set_difference(arrcat(ObjSearch("..Segments.Foot", "AnySeg"),
                         ObjSearch("..Segments.Foot.*", "AnySeg")),
                  ObjSearch("..Segments.Foot.Talus", "AnySeg"));

  #ifndef LEG_WITH_JOINT_MUSCLES
  IncludeForces = arrcat(
    ObjSearch("..Muscles.*.FlexorDigitorum*", "AnyMuscle"),
    ObjSearch("..Muscles.*.FlexorHallucis*", "AnyMuscle"),
    ObjSearch("..Muscles.*.TibialisPosterior*", "AnyMuscle"),
    ObjSearch("..Muscles.*.TibialisAnterior*", "AnyMuscle"),
    ObjSearch("..Muscles.*.ExtensorDigitorum*", "AnyMuscle"),
    ObjSearch("..Muscles.*.ExtensorHallucis*", "AnyMuscle")
  );
  #endif

  AnyVec3 Mlocal=M*ref.Axes;
  AnyVar MSubTalarEversion=Mlocal[2];
};

AnyForceMomentMeasure2 EversionMusclesSubtalarEversion = {
  AnyRefNode &ref=..Segments.Talus.SubTalarJoint;
//  AnySeg &seg=..Segments.Foot;
  IncludeSegments =
   set_difference(arrcat(ObjSearch("..Segments.Foot", "AnySeg"),
                         ObjSearch("..Segments.Foot.*", "AnySeg")),
                  ObjSearch("..Segments.Foot.Talus", "AnySeg"));

  #ifndef LEG_WITH_JOINT_MUSCLES
  IncludeForces = arrcat(
    ObjSearch("..Muscles.*.PeroneusTertius*", "AnyMuscle"),
    ObjSearch("..Muscles.*.PeroneusBrevis*", "AnyMuscle"),
    ObjSearch("..Muscles.*.PeroneusLongus*", "AnyMuscle")
  );
  #endif
  AnyVec3 Mlocal=M*ref.Axes;
  AnyVar MSubTalarEversion=Mlocal[2];
};

AnyForceMomentMeasure2 KneeNetMomentMuscle =
{
  AnyRefFrame &ref = ..Segments.Thigh.KneeJoint.RotNode;
  //RefPoint = &..Segments.Thigh.KneeJoint.RotNode;
//  IncludeSegments =
//  {
//    &..Segments.Shank, &..Segments.Foot, &..Segments.Talus
//  };
  IncludeSegments =
      arrcat(&..Segments.Shank,
             ObjSearch("..Segments.Foot", "AnySeg"),
             ObjSearch("..Segments.Foot.*", "AnySeg"));

  AnyObjectPtrArray pArrJntReactions = {
    &..Joints.PatellaMovement.Reaction
  };
  IncludeForces = arrcat(
    ObjSearch("..Muscles.*.*", "AnyMuscle"),
    ObjSearch("..TrunkMuscles.PsoasMajor.*", "AnyMuscle"),
    ObjSearchRecursive("..JointMuscles", "*", "AnyMuscle"),
    pArrJntReactions
  );

  AnyVec3 Mlocal=M*ref.Axes;
  AnyVar MKneeFlexion=Mlocal[2];
};

AnyFolder &HipNodeRef =.Segments.Pelvis;
HipNodeRef={
  HipJoint ={
    AnyRefNode NeutralOrientation ={
      ARel=......Trunk.Segments.PelvisSeg.AnatomicalFrameTrunk.ARel;
      AnyRefNode RotNode={
        ARel= {{...Sign*-1,0,0},{0,...Sign*-1,0},{0,0,1}};
      };
    };
  };
};

AnyForceMomentMeasure2 HipNetMomentMuscle =
{
  AnyRefFrame &ref = ..Segments.Pelvis.HipJoint.NeutralOrientation.RotNode;
//  IncludeSegments =
//  {
//    &..Segments.Shank, &..Segments.Foot, &..Segments.Thigh, &..Segments.Talus, &..Segments.Patella
//  };
  IncludeSegments =
      arrcat(&..Segments.Shank, &..Segments.Thigh, &..Segments.Patella,
             ObjSearch("..Segments.Foot", "AnySeg"),
             ObjSearch("..Segments.Foot.*", "AnySeg"));

  IncludeForces = arrcat(
    ObjSearch("..Muscles.*.*", "AnyMuscle"),
    ObjSearch("..TrunkMuscles.PsoasMajor.*", "AnyMuscle"),
    ObjSearchRecursive("..JointMuscles", "*", "AnyMuscle")
  );

  AnyVec3 Mlocal=M*ref.Axes;
  AnyVar MHipAbduction=Mlocal[0];
  AnyVar MHipFlexion=Mlocal[2];
  AnyVar MHipExternalRotation=Mlocal[1];
};

//****************************************************************************

AnyForceMomentMeasure2 AnklePlantarFlexionNetMoment =
{
  AnyRefNode &ref = ..Segments.Shank.AnkleJoint;
  //RefPoint = &..Segments.Shank.AnkleJoint;
//  IncludeSegments =
//  {
//    &..Segments.Foot, &..Segments.Talus
//  };
  IncludeSegments =
    arrcat(ObjSearch("..Segments.Foot", "AnySeg"),
           ObjSearch("..Segments.Foot.*", "AnySeg"));

  AnyObjectPtrArray pArrJntReactions = {
    &..Joints.Ankle.Constraints.Reaction,
    &..Joints.SubTalar.Constraints.Reaction
  };
  IncludeForces = arrcat(
    ObjSearch("..Muscles.*.*", "AnyMuscle"),
    ObjSearch("..TrunkMuscles.PsoasMajor.*", "AnyMuscle"),
    ObjSearchRecursive("..JointMuscles", "*", "AnyMuscle"),
    pArrJntReactions
  );
};

AnyForceMomentMeasure2 SubTalarEversionNetMoment =
{
  AnyRefFrame &ref = ..Segments.Talus.SubTalarJoint;
  //RefPoint = &..Segments.Talus.SubTalarJoint;
//  IncludeSegments =
//  {
//    &..Segments.Foot
//  };
  IncludeSegments =
   set_difference(arrcat(ObjSearch("..Segments.Foot", "AnySeg"),
                         ObjSearch("..Segments.Foot.*", "AnySeg")),
                  ObjSearch("..Segments.Foot.Talus", "AnySeg"));

  AnyObjectPtrArray pArrJntReactions = {
    &..Joints.SubTalar.Constraints.Reaction
  };
  IncludeForces = arrcat(
    ObjSearch("..Muscles.*.*", "AnyMuscle"),
    ObjSearch("..TrunkMuscles.PsoasMajor.*", "AnyMuscle"),
    ObjSearchRecursive("..JointMuscles", "*", "AnyMuscle"),
    pArrJntReactions
  );
};

AnyForceMomentMeasure2 KneeNetMoment =
{
  AnyRefFrame &ref = ..Segments.Thigh.KneeJoint.RotNode;
  //RefPoint = &..Segments.Thigh.KneeJoint.RotNode;
//  IncludeSegments =
//  {
//    &..Segments.Shank, &..Segments.Foot, &..Segments.Talus
//  };
  IncludeSegments =
      arrcat(&..Segments.Shank,
             ObjSearch("..Segments.Foot", "AnySeg"),
             ObjSearch("..Segments.Foot.*", "AnySeg"));

  AnyObjectPtrArray pArrJntReactions =
  {
    &..Joints.Knee.Constraints.Reaction,
    &..Joints.Ankle.Constraints.Reaction,
    &..Joints.SubTalar.Constraints.Reaction,
    &..Joints.PatellaMovement.Reaction
  };
  #include  "LegMusclePtrArrays.any"
  IncludeForces = arrcat(pArrTargetMuscles,pArrJntReactions);
};

AnyForceMomentMeasure2 HipNetMoment =
{
  AnyRefFrame &ref = ..Segments.Pelvis.HipJoint.RotNode;
  //RefPoint = &..Segments.Pelvis.HipJoint.RotNode;
//  IncludeSegments =
//  {
//    &..Segments.Shank, &..Segments.Foot, &..Segments.Thigh, &..Segments.Patella, &..Segments.Talus
//  };
  IncludeSegments =
      arrcat(&..Segments.Shank, &..Segments.Thigh, &..Segments.Patella,
             ObjSearch("..Segments.Foot", "AnySeg"),
             ObjSearch("..Segments.Foot.*", "AnySeg"));

  AnyObjectPtrArray pArrJntReactions =
  {
    &..Joints.Hip.Constraints.Reaction,
    &..Joints.Knee.Constraints.Reaction,
    &..Joints.Ankle.Constraints.Reaction,
    &..Joints.SubTalar.Constraints.Reaction,
    &..Joints.PatellaFemur.Constraints.Reaction,
    &..Joints.PatellaMovement.Reaction
  };
  IncludeForces = arrcat(
    ObjSearch("..Muscles.*.*", "AnyMuscle"),
    ObjSearch("..TrunkMuscles.PsoasMajor.*", "AnyMuscle"),
    ObjSearchRecursive("..JointMuscles", "*", "AnyMuscle"),
    pArrJntReactions
  );
};


AnyForceMomentMeasure AnkleJointReactionMoments =
{
  AnyForceBase &Force = ..Joints.Ankle.Constraints.Reaction;
  AnyRefFrame &Shankankle = ..Segments.Shank.AnkleJoint;
  AnyVec3 Mlocal = M*Shankankle.Axes;
};

#endif

AnyForceMomentMeasure2 KneeJointReactionMoments =
{
  AnyForceBase &Force = ..Joints.Knee.Constraints.Reaction;
  AnyRefFrame &Thighknee = ..Segments.Thigh.KneeJoint;
  IncludeSegments = {&..Segments.Thigh};
  AnyVec3 Mlocal = M*Thighknee.Axes;
};
