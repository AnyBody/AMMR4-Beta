
//Right leg

Segments.Thigh.Axes0 ??=
..Trunk.Segments.PelvisSeg.Axes0*
Segments.Pelvis.ARel*
Segments.Pelvis.HipJoint.ARel*
Segments.Pelvis.HipJoint.RotNode.ARel*
RotMat((pi/180)*.JointPos.HipFlexion,z)*
RotMat((pi/180)*.JointPos.HipAbduction,x)*
RotMat((pi/180)*.JointPos.HipExternalRotation,y)*
Segments.Thigh.HipJoint.RotNode.ARel'*
Segments.Thigh.HipJoint.ARel';

//shank
Segments.Shank.Axes0 ??=
Segments.Thigh.Axes0*
Segments.Thigh.KneeJoint.ARel*
Segments.Thigh.KneeJoint.RotNode.ARel*
RotMat((-pi/180)*.JointPos.KneeFlexion,z)*
Segments.Shank.KneeJoint.RotNode.ARel'*
Segments.Shank.KneeJoint.ARel';

//Patella
Segments.Patella.Axes0 ??= Segments.Thigh.Axes0*
Segments.Thigh.PatellaFemurJoint.ARel*
Segments.Thigh.PatellaFemurJoint.RotNode.ARel*
RotMat((-pi/180)*.JointPos.KneeFlexion,z)*
Segments.Patella.PatellaFemurJoint.RotNode.ARel'*
Segments.Patella.PatellaFemurJoint.ARel';

//Segments.Patella.Axes0 = Segments.Shank.Axes0;



#if BM_FOOT_MODEL == _FOOT_MODEL_LEG_FOOT_
//Talus
Segments.Talus.Axes0 ??=
Segments.Shank.Axes0*
Segments.Shank.AnkleJoint.ARel*
//Segments.Shank.AnkleJoint.RotNode.ARel*
RotMat((-pi/180)*.JointPos.AnklePlantarFlexion ,z)*
//Segments.Talus.AnkleJoint.RotNode.ARel'*
Segments.Talus.AnkleJoint.ARel';


//Foot
Segments.Foot.Axes0 ??=
Segments.Talus.Axes0*
Segments.Talus.SubTalarJoint.ARel*
//Segments.Talus.SubTalarJoint.RotNode.ARel*
RotMat((pi/180)*.JointPos.SubTalarEversion ,z)*
//Segments.Foot.SubTalarJoint.RotNode.ARel'*
Segments.Foot.SubTalarJoint.ARel';
#endif


