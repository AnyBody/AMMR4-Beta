/*
  File containing the BM dependent objects for the calibration studies.
*/

/// Mech Objects for the shoulder rythm. 
/// These are excluded from the calibration (if found) 
/// since the calibration drivers handles all DOFs.
AnyMechObjectExcluder ExcludeShoulderRhythm = {
  Objects = arrcat(
    ObjSearch(&.Joints, "ClaviculaProtractionDriver"),
    ObjSearch(&.Joints, "ClaviculaElevationDriver"),
    ObjSearch(&.Joints, "ClaviculaAxialRotationDriver")
  );
};

