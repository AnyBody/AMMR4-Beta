          AnyVar MultifidusLumborumL1L5 = -1*...Model.SpineMusRightRef.Multifidi.MultifidusLumborumL1L5.LmtDot/...Model.Drivers.AngularVelocity;
          AnyVar MultifidusLumborumL1S1 = -1*...Model.SpineMusRightRef.Multifidi.MultifidusLumborumL1S1.LmtDot/...Model.Drivers.AngularVelocity;
          AnyVar MultifidusLumborumL2L5 = -1*...Model.SpineMusRightRef.Multifidi.MultifidusLumborumL2L5.LmtDot/...Model.Drivers.AngularVelocity;
          AnyVar MultifidusLumborumL2S1 = -1*...Model.SpineMusRightRef.Multifidi.MultifidusLumborumL2S1.LmtDot/...Model.Drivers.AngularVelocity;
          AnyVar MultifidusLumborumL3S2 = -1*...Model.SpineMusRightRef.Multifidi.MultifidusLumborumL3S2.LmtDot/...Model.Drivers.AngularVelocity;
          AnyVar MultifidusLumborumL4S2 = -1*...Model.SpineMusRightRef.Multifidi.MultifidusLumborumL4S2.LmtDot/...Model.Drivers.AngularVelocity;
          AnyVar MultifidusLumborumL5S3 = -1*...Model.SpineMusRightRef.Multifidi.MultifidusLumborumL5S3.LmtDot/...Model.Drivers.AngularVelocity;
          AnyVar MultifidusLumborumtL1IC = -1*...Model.SpineMusRightRef.Multifidi.MultifidusLumborumtL1IC.LmtDot/...Model.Drivers.AngularVelocity;
          AnyVar MultifidusLumborumtL2IC = -1*...Model.SpineMusRightRef.Multifidi.MultifidusLumborumtL2IC.LmtDot/...Model.Drivers.AngularVelocity;
