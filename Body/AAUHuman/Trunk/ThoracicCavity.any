AnyFolder ThoracicCavity = {
  #include "NodesForThoracicCavity.any"

  #if (BM_TRUNK_CAVITY_MODEL == _CAVITY_MODEL_VOLUME_) & (BM_TRUNK_MUSCLES == ON)

    AnyKinVolumeCylMesh Volume = {
      viewKinMeasure = {
        Visible  ??=  .....DrawSettings.KinematicVolume.Visible;
        RGB1  ??=  .....DrawSettings.KinematicVolume.RGB1;
        RGB3  ??=  .....DrawSettings.KinematicVolume.RGB3;
        RGB2 = {0.9, 0.7, 0.7};
        RGB4  ??=  .....DrawSettings.KinematicVolume.RGB4;
        ShowLabelLines  ??=  .....DrawSettings.KinematicVolume.ShowLabelLines;
        Label   ??=  .....DrawSettings.KinematicVolume.Label;
        ShowValue  ??=  .....DrawSettings.KinematicVolume.ShowValue;
        Opacity  ??=  .....DrawSettings.KinematicVolume.Opacity;
        PickableZOrdering  ??=   .....DrawSettings.KinematicVolume.PickableZOrdering;
      };

      CylMesh  = ({
        repmat(
          ((..Data.unscaled.ModelParameters.ThoracicCavity.DiscretizationPosterior + ..Data.unscaled.ModelParameters.ThoracicCavity.DiscretizationAnterior) * 2),
          &..Abdominal.Diaphragm.CavitySegSuperoanterior.Layer_T10.VolumePoints.Center
        ),
           ..Abdominal.Diaphragm.CavitySegSuperoanterior.Layer_T10.FullEdge,
           ..Abdominal.Diaphragm.CavitySeg.Layer_T12.FullEdge,
           ..Abdominal.Diaphragm.BaseSegInferior.Layer_T12.FullEdge,

          .Edges.Edge10,
          .Edges.Edge9,
          .Edges.Edge8,
          .Edges.Edge7,
          .Edges.Edge6,
          .Edges.Edge5,
          .Edges.Edge4,
          .Edges.Edge3,
          .Edges.Edge2,
          .Edges.Edge1,
          .Edges.Edge0
      });
    };
  #endif

  #include "ThoracicInertia.any"
};
