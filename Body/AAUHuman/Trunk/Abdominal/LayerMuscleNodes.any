Layer_L1.BaseSegPosterior= {
  ///^ The new via-nodes of the erector spinae muscles were placed on the layers instead of the vertebrae, but use the same position data as before.
  ///^ Since the nodes were originally defined at the same height as the spinous process of the vertebrae, they were moved to a layer below to be closer
  ///^ to the center of the layer joint longitudinally. Note that since we used the old data, the via-nodes are not exactly at the same height as the
  ///^ layer joints. However, with the new implementation, the model is less sensitive to the location of the via-nodes than before, as the layers are
  ///^ connected to each other with three rotationally recruited actuators, and the abdominal muscles help balance this interconnected layer structure.
  ///^ In the previous implementation, the via-nodes were placed on the vertebrae with a moment arm relative to the center of the vertebra or
  ///^ intervertebral joint, making the model more sensitive to changes in the via-node position.


  AnyRefNode IliocostalisLumborumR5Via6NodeR = {sRel = ..Segref.ScaleAbdominal(....Data.unscaled.ModelParameters.R12.Right.IliocostalisLumborumR5Via6Node_pos);};
  AnyRefNode IliocostalisLumborumR5Via6NodeL = {sRel = ..Segref.ScaleAbdominal(....Data.unscaled.ModelParameters.R12.Left.IliocostalisLumborumR5Via6Node_pos);};
  AnyRefNode IliocostalisLumborumR6Via5NodeR = {sRel = ..Segref.ScaleAbdominal(....Data.unscaled.ModelParameters.R12.Right.IliocostalisLumborumR6Via5Node_pos);};
  AnyRefNode IliocostalisLumborumR6Via5NodeL = {sRel = ..Segref.ScaleAbdominal(....Data.unscaled.ModelParameters.R12.Left.IliocostalisLumborumR6Via5Node_pos);};
  AnyRefNode IliocostalisLumborumR7Via4NodeR = {sRel = ..Segref.ScaleAbdominal(....Data.unscaled.ModelParameters.R12.Right.IliocostalisLumborumR7Via4Node_pos);};
  AnyRefNode IliocostalisLumborumR7Via4NodeL = {sRel = ..Segref.ScaleAbdominal(....Data.unscaled.ModelParameters.R12.Left.IliocostalisLumborumR7Via4Node_pos);};
  AnyRefNode IliocostalisLumborumR8Via3NodeR = {sRel = ..Segref.ScaleAbdominal(....Data.unscaled.ModelParameters.R12.Right.IliocostalisLumborumR8Via3Node_pos);};
  AnyRefNode IliocostalisLumborumR8Via3NodeL = {sRel = ..Segref.ScaleAbdominal(....Data.unscaled.ModelParameters.R12.Left.IliocostalisLumborumR8Via3Node_pos);};
  AnyRefNode IliocostalisLumborumR9Via2NodeR = {sRel = ..Segref.ScaleAbdominal(....Data.unscaled.ModelParameters.R12.Right.IliocostalisLumborumR9Via2Node_pos);};
  AnyRefNode IliocostalisLumborumR9Via2NodeL = {sRel = ..Segref.ScaleAbdominal(....Data.unscaled.ModelParameters.R12.Left.IliocostalisLumborumR9Via2Node_pos);};
  AnyRefNode IliocostalisLumborumR10Via1NodeR = {sRel = ..Segref.ScaleAbdominal(....Data.unscaled.ModelParameters.R12.Right.IliocostalisLumborumR10Via1Node_pos);};
  AnyRefNode IliocostalisLumborumR10Via1NodeL = {sRel = ..Segref.ScaleAbdominal(....Data.unscaled.ModelParameters.R12.Left.IliocostalisLumborumR10Via1Node_pos);};
  AnyRefNode LTptT10SacrumVia2NodeR = {sRel = ..Segref.ScaleAbdominal(....Data.unscaled.ModelParameters.Thorax.Right.LTptT10SacrumVia2Node_pos);};
  AnyRefNode LTptT10SacrumVia2NodeL = {sRel = ..Segref.ScaleAbdominal(....Data.unscaled.ModelParameters.Thorax.Left.LTptT10SacrumVia2Node_pos);};
  AnyRefNode LTptT11SacrumVia1NodeR = {sRel = ..Segref.ScaleAbdominal(....Data.unscaled.ModelParameters.Thorax.Right.LTptT11SacrumVia1Node_pos);};
  AnyRefNode LTptT11SacrumVia1NodeL = {sRel = ..Segref.ScaleAbdominal(....Data.unscaled.ModelParameters.Thorax.Left.LTptT11SacrumVia1Node_pos);};
  AnyRefNode LTptC10SacrumVia2NodeR = {sRel = ..Segref.ScaleAbdominal(....Data.unscaled.ModelParameters.R12.Right.LTptC10SacrumVia2Node_pos);};
  AnyRefNode LTptC10SacrumVia2NodeL = {sRel = ..Segref.ScaleAbdominal(....Data.unscaled.ModelParameters.R12.Left.LTptC10SacrumVia2Node_pos);};
  AnyRefNode LTptC11SacrumVia1NodeR = {sRel = ..Segref.ScaleAbdominal(....Data.unscaled.ModelParameters.R12.Right.LTptC11SacrumVia1Node_pos);};
  AnyRefNode LTptC11SacrumVia1NodeL = {sRel = ..Segref.ScaleAbdominal(....Data.unscaled.ModelParameters.R12.Left.LTptC11SacrumVia1Node_pos);};
};

