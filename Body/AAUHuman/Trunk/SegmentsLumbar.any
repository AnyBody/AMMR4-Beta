  /*
Definitions of Segments in the Lumbar Part of the Spine + the pelvis
Abbrevitations:
ALL = Anterior Longitudinal Ligament
PLL = Posterior Longitudinal Ligament
LS = Ligamentum Supraspinale
LI = Ligamentum Interspinalia

MF = Multifidi
ILpl = Iliocostalis Lumborum pars lumborum (part of Erector Spinae)
LTpl = Longissimus Thoracis pars lumborum (part of Erector Spinae)
ILpt = Iliocostalis Lumborum pars thoracis (part of Erector Spinae)
LTpt = Longissimus Thoracis pars thoracis (part of Erector Spinae)
PM = Psoas Major
QL = Quadratus Lumborum
RA = Rectus Abdominis
OE = Obliquus Externus
OI = Obliquus Internus

C = Costae
CI = Crista Iliaca
CP = Crista Pubica
SIPS = Spina iliaca posterior superior
SIPI = Spina iliaca Posterior inferior
T = Thoracal hvirvel
L = Lumbal hvirvel
S = Sacral segment
*/
#include "PelvisSeg.any"

#include "SegmentsLumbar.Muscles.any"

TrunkSegmentBase SacrumSeg(
  DATA = ..Data.unscaled,
  CRANIAL_NEIGHBOUR = L5,
  LEVEL = Sacrum,
  CAUDAL_NEIGHBOUR = Pelvis,
  DEF_SCALING = 0,  // reusing pelvis
  DEF_CONTACTS = 0,
  DEF_DRAWING = 0,
  _VOLUMETRIC_CAVITY = BM_TRUNK_CAVITY_MODEL,
  PelvisSeg=..PelvisSeg
  ) = {
  //initial position found as a function of pelvis pos and orientation
  Axes0=.PelvisSeg.Axes0;

  // Sacrum is part of the pelvis so they scale together
  AnyRefNode& ScalingNode = AnatomicalFrameTrunk;
  AnyRefNode AnatomicalFrameTrunk = {
    sRel = ..PelvisSeg.AnatomicalFrameTrunk.sRel;
    ARel = ..PelvisSeg.AnatomicalFrameTrunk.ARel;
  };
  AnyFunTransform3D& Scale = .PelvisSeg.Scale;

  AnyRefNode SacrumContactNode = {sRel= .Scale(.Data.SacrumContactNode_pos);};

  AnyRefNode SacrumBonyTip ={sRel= .Scale(.Data.SacrumBonyTip_pos);};
  AnyRefNode SacrumPosteriorSuperior ={sRel= .Scale(.Data.SacrumPosteriorSuperior_pos);};

  // -------- Drawing object section sacrum--------
  #if BM_PELVIS_DISPLAY == _PELVIS_DISPLAY_LEGPELVIS_ONLY_
  AnyDrawSurf &BoneDraw = DrwSacrum;
  AnyDrawSurf DrwSacrum = {
    Opacity = Main.DrawSettings.BonesOpacity.Sacrum;
    FileName = ...Data.unscaled.STL.FilenameSacrumSeg;
    RGB = ...ColorRef.Segments;
    AnyFunTransform3D &Scale =.Scale;
  };
  // -------- End of drawing section sacrum--------
  #endif
  }; // SacrumSeg


TrunkSegmentBase L5Seg(
  DATA = ..Data.unscaled,
  CRANIAL_NEIGHBOUR = L4,
  LEVEL = L5,
  CAUDAL_NEIGHBOUR = Sacrum,
  _VOLUMETRIC_CAVITY = BM_TRUNK_CAVITY_MODEL,
  PelvisSeg=..PelvisSeg
  ) = {
}; // End of L5Seg

TrunkSegmentBase L4Seg(
  DATA = ..Data.unscaled,
  CRANIAL_NEIGHBOUR = L3,
  LEVEL = L4,
  CAUDAL_NEIGHBOUR = L5,
  _VOLUMETRIC_CAVITY = BM_TRUNK_CAVITY_MODEL,
  PelvisSeg=..PelvisSeg
  ) = {
}; // End of L4Seg

TrunkSegmentBase L3Seg(
  DATA = ..Data.unscaled,
  CRANIAL_NEIGHBOUR = L2,
  LEVEL = L3,
  CAUDAL_NEIGHBOUR = L4,
  _VOLUMETRIC_CAVITY = BM_TRUNK_CAVITY_MODEL,
  PelvisSeg=..PelvisSeg
  ) = {
}; // End of L3Seg

TrunkSegmentBase L2Seg(
  DATA = ..Data.unscaled,
  CRANIAL_NEIGHBOUR = L1,
  LEVEL = L2,
  CAUDAL_NEIGHBOUR = L3,
  _VOLUMETRIC_CAVITY = BM_TRUNK_CAVITY_MODEL,
  PelvisSeg=..PelvisSeg
  ) = {
}; // End of L2Seg

TrunkSegmentBase L1Seg(
  DATA = ..Data.unscaled,
  CRANIAL_NEIGHBOUR = T12,
  LEVEL = L1,
  CAUDAL_NEIGHBOUR = L2,
  _VOLUMETRIC_CAVITY = BM_TRUNK_CAVITY_MODEL,
  PelvisSeg=..PelvisSeg
  ) = {
}; // End of L1Seg
