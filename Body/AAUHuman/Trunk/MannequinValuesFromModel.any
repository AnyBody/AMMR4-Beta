//This controls the position of the pelvi wrt. to the global reference frame
AnyVar AnyVar_PelvisPosX = ..Interface.Trunk.PelvisPosX.Pos[0];
AnyVar AnyVar_PelvisPosY = ..Interface.Trunk.PelvisPosY.Pos[0];
AnyVar AnyVar_PelvisPosZ = ..Interface.Trunk.PelvisPosZ.Pos[0];

//This controls the rotation of the pelvis wrt. to the global reference frame
AnyVar AnyVar_PelvisRotX = ..Interface.Trunk.PelvisRotX.Pos[0]*180/pi;
AnyVar AnyVar_PelvisRotY = ..Interface.Trunk.PelvisRotY.Pos[0]*180/pi;
AnyVar AnyVar_PelvisRotZ = ..Interface.Trunk.PelvisRotZ.Pos[0]*180/pi;

// These variables control the rotation of the thorax wrt the
// pelvis
AnyVar AnyVar_PelvisThoraxExtension = ..Interface.Trunk.PelvisThoraxExtension.Pos[0]*180/pi;
AnyVar AnyVar_PelvisThoraxLateralBending = ..Interface.Trunk.PelvisThoraxLateralBending.Pos[0]*180/pi;
AnyVar AnyVar_PelvisThoraxRotation = ..Interface.Trunk.PelvisThoraxRotation.Pos[0]*180/pi;

AnyVar AnyVar_NeckExtension = 0;
