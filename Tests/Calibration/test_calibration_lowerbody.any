//   [
//    {'BM_LEG_MODEL':'_LEG_MODEL_TLEM1_'},
//    {'BM_LEG_MODEL':'_LEG_MODEL_TLEM2_'},
//    {'BM_LEG_MODEL':'_LEG_MODEL_LEG_'},
