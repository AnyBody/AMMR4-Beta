/* Range of Motion definition for the trunk model */

AnyFolder RangeOfMotion = {
  AnyFolder ROM_Kinematics_FlexibleThorax = {
    // Range of Motion of Kinematics with flexible thorax
    AnyVar MaxPelvisThoraxFlexionAngle = -250;
    AnyVar MaxPelvisThoraxExtensionAngle = 280;
    AnyVar MaxPelvisThoraxLateralBendingAngle = 150;
//    AnyVar MinPelvisThoraxLateralBendingAngle = -150;
    AnyVar MaxPelvisThoraxAxialRotationAngle = 200;
//    AnyVar MinPelvisThoraxAxialRotationAngle = -200;
  };
  AnyFolder ROM_InverseDynamics_FlexibleThorax = {
    // Range of Motion of InverseDynamics with flexible thorax
    // InverseDynamics has a big range og motion, but we have not used this number since it is too extreme.
    //    AnyVar MaxPelvisThoraxFlexionAngle = -250; 
    //    AnyVar MaxPelvisThoraxExtensionAngle = 150;
    //    AnyVar MaxPelvisThoraxLateralBendingAngle = 85;
    ////    AnyVar MinPelvisThoraxLateralBendingAngle = -85;
    //    AnyVar MaxPelvisThoraxAxialRotationAngle = 200;
    ////    AnyVar MinPelvisThoraxAxialRotationAngle = -200;
    
    // Instead we used these values:
    AnyVar MaxPelvisThoraxFlexionAngle = -110;
    AnyVar MaxPelvisThoraxExtensionAngle = 50;
    AnyVar MaxPelvisThoraxLateralBendingAngle = 85;
    AnyVar MaxPelvisThoraxAxialRotationAngle = 90;
  };
  AnyFolder ROM_Kinematics_RigidThorax = {
    // Range of Motion of Kinematics with rigid thorax
    AnyVar MaxPelvisThoraxFlexionAngle = -110;
    AnyVar MaxPelvisThoraxExtensionAngle = 280;
    AnyVar MaxPelvisThoraxLateralBendingAngle = 210;
//    AnyVar MinPelvisThoraxLateralBendingAngle = -210;
    AnyVar MaxPelvisThoraxAxialRotationAngle = 160;
//    AnyVar MinPelvisThoraxAxialRotationAngle = -160;
  };
  AnyFolder ROM_InverseDynamics_RigidThorax = {
    // Range of Motion of Kinematics with rigid thorax
    // InverseDynamics has a big range og motion, but we have not used this number since it is too extreme.
    //    AnyVar MaxPelvisThoraxFlexionAngle = -110;
    //    AnyVar MaxPelvisThoraxExtensionAngle = 280;
    //    AnyVar MaxPelvisThoraxLateralBendingAngle = 210;
    ////    AnyVar MinPelvisThoraxLateralBendingAngle = -210;
    //    AnyVar MaxPelvisThoraxAxialRotationAngle = 160;
    ////    AnyVar MinPelvisThoraxAxialRotationAngle = -160;
    
    // Instead we used these values:
    AnyVar MaxPelvisThoraxFlexionAngle = -110;
    AnyVar MaxPelvisThoraxExtensionAngle = 50;
    AnyVar MaxPelvisThoraxLateralBendingAngle = 90;
    AnyVar MaxPelvisThoraxAxialRotationAngle = 90;
  };

  // AnyFolder Right = {};
  // AnyFolder Left = {};
};
